  "required": [
    "source_subject_id",
    "source_evaluation_subject_sha256",
    "source_adapter_artifact_sha256",
    "source_adapter_weights_sha256",
    "derived_adapter_artifact_sha256",
    "derived_adapter_weights_sha256",

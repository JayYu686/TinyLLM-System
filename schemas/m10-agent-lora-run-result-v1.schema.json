{
  "$defs": {
    "M10LoRAStageExport": {
      "additionalProperties": false,
      "description": "Immutable Adapter export for one evaluated stage.",
      "properties": {
        "adapter_artifact_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Adapter Artifact Sha256",
          "type": "string"
        },
        "adapter_files": {
          "items": {
            "enum": [
              "adapter_config.json",
              "adapter_model.safetensors"
            ],
            "type": "string"
          },
          "title": "Adapter Files",
          "type": "array"
        },
        "checkpoint_id": {
          "pattern": "^checkpoint-tokens-[0-9]{10}$",
          "title": "Checkpoint Id",
          "type": "string"
        },
        "supervised_tokens": {
          "enum": [
            1000000,
            5000000,
            10000000
          ],
          "title": "Supervised Tokens",
          "type": "integer"
        }
      },
      "required": [
        "checkpoint_id",
        "supervised_tokens",
        "adapter_artifact_sha256",
        "adapter_files"
      ],
      "title": "M10LoRAStageExport",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Path-free result for one fresh or Exact-Resume stage.",
  "properties": {
    "adaptation": {
      "const": "lora",
      "title": "Adaptation",
      "type": "string"
    },
    "attention_architecture": {
      "const": "gqa",
      "title": "Attention Architecture",
      "type": "string"
    },
    "completed_epochs": {
      "maximum": 10,
      "minimum": 1,
      "title": "Completed Epochs",
      "type": "integer"
    },
    "config_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Config Sha256",
      "type": "string"
    },
    "continuation_gate_sha256": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Continuation Gate Sha256"
    },
    "dataset_manifest_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Dataset Manifest Sha256",
      "type": "string"
    },
    "dataset_version": {
      "pattern": "^m10-agent-sft-v[12]-[0-9a-f]{8}$",
      "title": "Dataset Version",
      "type": "string"
    },
    "duration_seconds": {
      "exclusiveMinimum": 0,
      "title": "Duration Seconds",
      "type": "number"
    },
    "final_loss": {
      "exclusiveMinimum": 0,
      "title": "Final Loss",
      "type": "number"
    },
    "git_commit": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Git Commit",
      "type": "string"
    },
    "git_dirty": {
      "const": false,
      "title": "Git Dirty",
      "type": "boolean"
    },
    "global_step": {
      "exclusiveMinimum": 0,
      "title": "Global Step",
      "type": "integer"
    },
    "gpu_name": {
      "const": "NVIDIA GeForce RTX 3090",
      "title": "Gpu Name",
      "type": "string"
    },
    "initial_loss": {
      "exclusiveMinimum": 0,
      "title": "Initial Loss",
      "type": "number"
    },
    "latest_checkpoint": {
      "pattern": "^checkpoint-tokens-[0-9]{10}$",
      "title": "Latest Checkpoint",
      "type": "string"
    },
    "memory_probe_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Memory Probe Sha256",
      "type": "string"
    },
    "mode": {
      "enum": [
        "fresh",
        "exact_resume"
      ],
      "title": "Mode",
      "type": "string"
    },
    "parent_evaluation_subject": {
      "const": "qwen3-8b-m9-base-90587dd6",
      "title": "Parent Evaluation Subject",
      "type": "string"
    },
    "parent_evaluation_subject_sha256": {
      "const": "9f72bba28bcfaed45f116080033cb9bc83be1632570e71623f2a5684350261d8",
      "title": "Parent Evaluation Subject Sha256",
      "type": "string"
    },
    "parent_model_artifact_sha256": {
      "const": "81fec43ab8b1f03a158e39e50ec23d99cf8701144e8678aea3ca656d12d08de0",
      "title": "Parent Model Artifact Sha256",
      "type": "string"
    },
    "peak_allocated_bytes": {
      "exclusiveMinimum": 0,
      "title": "Peak Allocated Bytes",
      "type": "integer"
    },
    "peak_reserved_bytes": {
      "exclusiveMinimum": 0,
      "title": "Peak Reserved Bytes",
      "type": "integer"
    },
    "peft_version": {
      "const": "0.19.1",
      "title": "Peft Version",
      "type": "string"
    },
    "physical_gpu_index": {
      "minimum": 0,
      "title": "Physical Gpu Index",
      "type": "integer"
    },
    "resumed_from_tokens": {
      "anyOf": [
        {
          "exclusiveMaximum": 10000000,
          "minimum": 1000000,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Resumed From Tokens"
    },
    "run_id": {
      "maxLength": 180,
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "seed": {
      "const": 42,
      "title": "Seed",
      "type": "integer"
    },
    "stage_export": {
      "$ref": "#/$defs/M10LoRAStageExport"
    },
    "status": {
      "enum": [
        "stage_completed",
        "succeeded"
      ],
      "title": "Status",
      "type": "string"
    },
    "supervised_tokens": {
      "enum": [
        1000000,
        5000000,
        10000000
      ],
      "title": "Supervised Tokens",
      "type": "integer"
    },
    "total_parameters": {
      "exclusiveMinimum": 0,
      "title": "Total Parameters",
      "type": "integer"
    },
    "trainable_parameters": {
      "exclusiveMinimum": 0,
      "title": "Trainable Parameters",
      "type": "integer"
    }
  },
  "required": [
    "status",
    "mode",
    "run_id",
    "config_sha256",
    "git_commit",
    "git_dirty",
    "dataset_version",
    "dataset_manifest_sha256",
    "parent_evaluation_subject",
    "parent_evaluation_subject_sha256",
    "parent_model_artifact_sha256",
    "attention_architecture",
    "adaptation",
    "peft_version",
    "seed",
    "physical_gpu_index",
    "gpu_name",
    "trainable_parameters",
    "total_parameters",
    "global_step",
    "completed_epochs",
    "supervised_tokens",
    "initial_loss",
    "final_loss",
    "duration_seconds",
    "peak_allocated_bytes",
    "peak_reserved_bytes",
    "memory_probe_sha256",
    "latest_checkpoint",
    "stage_export"
  ],
  "title": "M10LoRARunResult",
  "type": "object"
}

{
  "$defs": {
    "M10ContaminationTargetResult": {
      "additionalProperties": false,
      "description": "Content-free result for one immutable evaluation target.",
      "properties": {
        "contains_target_content": {
          "const": false,
          "default": false,
          "title": "Contains Target Content",
          "type": "boolean"
        },
        "exact_matches": {
          "minimum": 0,
          "title": "Exact Matches",
          "type": "integer"
        },
        "maximum_candidate_prompt_similarity_basis_points": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Maximum Candidate Prompt Similarity Basis Points",
          "type": "integer"
        },
        "near_matches": {
          "minimum": 0,
          "title": "Near Matches",
          "type": "integer"
        },
        "target_content_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Target Content Sha256",
          "type": "string"
        },
        "target_id": {
          "enum": [
            "m9_dev",
            "m9_release",
            "bfcl_core",
            "m6_domain"
          ],
          "title": "Target Id",
          "type": "string"
        },
        "target_items": {
          "exclusiveMinimum": 0,
          "title": "Target Items",
          "type": "integer"
        },
        "target_version": {
          "maxLength": 180,
          "minLength": 1,
          "title": "Target Version",
          "type": "string"
        }
      },
      "required": [
        "target_id",
        "target_version",
        "target_content_sha256",
        "target_items",
        "exact_matches",
        "near_matches",
        "maximum_candidate_prompt_similarity_basis_points"
      ],
      "title": "M10ContaminationTargetResult",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Content-free four-boundary evaluation contamination report.",
  "properties": {
    "algorithm": {
      "const": "minhash-5gram-lsh-v1",
      "default": "minhash-5gram-lsh-v1",
      "title": "Algorithm",
      "type": "string"
    },
    "contains_evaluation_content": {
      "const": false,
      "default": false,
      "title": "Contains Evaluation Content",
      "type": "boolean"
    },
    "permutation_count": {
      "const": 128,
      "default": 128,
      "title": "Permutation Count",
      "type": "integer"
    },
    "report_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Report Sha256",
      "type": "string"
    },
    "scan_version": {
      "default": "m10-devops-contamination-v1",
      "enum": [
        "m10-devops-contamination-v1",
        "m10-devops-contamination-v2",
        "m10-devops-contamination-v3",
        "m10-devops-contamination-v4"
      ],
      "title": "Scan Version",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "shared_tool_schema_alone_is_match": {
      "const": false,
      "default": false,
      "title": "Shared Tool Schema Alone Is Match",
      "type": "boolean"
    },
    "source_content_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source Content Sha256",
      "type": "string"
    },
    "source_dataset_version": {
      "pattern": "^m10-devops-training-v[1234]-[0-9a-f]{8}$",
      "title": "Source Dataset Version",
      "type": "string"
    },
    "source_items": {
      "default": 2400,
      "enum": [
        2400,
        9600
      ],
      "title": "Source Items",
      "type": "integer"
    },
    "status": {
      "enum": [
        "pass",
        "fail"
      ],
      "title": "Status",
      "type": "string"
    },
    "targets": {
      "maxItems": 4,
      "minItems": 4,
      "prefixItems": [
        {
          "$ref": "#/$defs/M10ContaminationTargetResult"
        },
        {
          "$ref": "#/$defs/M10ContaminationTargetResult"
        },
        {
          "$ref": "#/$defs/M10ContaminationTargetResult"
        },
        {
          "$ref": "#/$defs/M10ContaminationTargetResult"
        }
      ],
      "title": "Targets",
      "type": "array"
    },
    "threshold_basis_points": {
      "const": 8500,
      "default": 8500,
      "title": "Threshold Basis Points",
      "type": "integer"
    }
  },
  "required": [
    "source_dataset_version",
    "source_content_sha256",
    "targets",
    "status",
    "report_sha256"
  ],
  "title": "M10DevOpsContaminationReport",
  "type": "object"
}

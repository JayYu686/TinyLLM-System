{
  "$defs": {
    "AgentToolDefinition": {
      "additionalProperties": false,
      "description": "Locally authorized tool metadata discovered from an MCP Server.",
      "properties": {
        "description": {
          "anyOf": [
            {
              "maxLength": 4096,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "input_schema": {
          "additionalProperties": true,
          "title": "Input Schema",
          "type": "object"
        },
        "server_id": {
          "pattern": "^[a-z][a-z0-9-]{2,63}$",
          "title": "Server Id",
          "type": "string"
        },
        "tool_name": {
          "pattern": "^[a-z][a-z0-9_]{1,63}$",
          "title": "Tool Name",
          "type": "string"
        }
      },
      "required": [
        "server_id",
        "tool_name",
        "input_schema"
      ],
      "title": "AgentToolDefinition",
      "type": "object"
    },
    "M10DevOpsFunctionCall": {
      "additionalProperties": false,
      "description": "One normalized OpenAI function invocation.",
      "properties": {
        "arguments": {
          "additionalProperties": true,
          "title": "Arguments",
          "type": "object"
        },
        "name": {
          "pattern": "^[a-z][a-z0-9_]{1,63}$",
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name",
        "arguments"
      ],
      "title": "M10DevOpsFunctionCall",
      "type": "object"
    },
    "M10DevOpsToolCall": {
      "additionalProperties": false,
      "description": "One assistant tool call with a stable conversation-local identifier.",
      "properties": {
        "function": {
          "$ref": "#/$defs/M10DevOpsFunctionCall"
        },
        "id": {
          "pattern": "^call_[a-z0-9_]{3,120}$",
          "title": "Id",
          "type": "string"
        },
        "type": {
          "const": "function",
          "default": "function",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "function"
      ],
      "title": "M10DevOpsToolCall",
      "type": "object"
    },
    "M10DevOpsTrainingMessage": {
      "additionalProperties": false,
      "description": "One canonical message and its immutable supervision decision.",
      "properties": {
        "content": {
          "anyOf": [
            {
              "maxLength": 262144,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content"
        },
        "message_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Message Sha256",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{1,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "role": {
          "enum": [
            "system",
            "user",
            "assistant",
            "tool"
          ],
          "title": "Role",
          "type": "string"
        },
        "supervised": {
          "title": "Supervised",
          "type": "boolean"
        },
        "tool_call_id": {
          "anyOf": [
            {
              "pattern": "^call_[a-z0-9_]{3,120}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Call Id"
        },
        "tool_calls": {
          "default": [],
          "items": {
            "$ref": "#/$defs/M10DevOpsToolCall"
          },
          "maxItems": 8,
          "title": "Tool Calls",
          "type": "array"
        }
      },
      "required": [
        "role",
        "supervised",
        "message_sha256"
      ],
      "title": "M10DevOpsTrainingMessage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One self-authored, policy-safe DevOps Agent SFT trajectory.",
  "properties": {
    "available_tools": {
      "items": {
        "$ref": "#/$defs/AgentToolDefinition"
      },
      "maxItems": 7,
      "minItems": 7,
      "title": "Available Tools",
      "type": "array"
    },
    "category": {
      "enum": [
        "single_tool",
        "no_tool",
        "wrong_tool_irrelevance",
        "missing_argument_clarification",
        "sequential_multi_step",
        "parallel_independent_tools",
        "tool_failure_recovery",
        "grounding_approval_security"
      ],
      "title": "Category",
      "type": "string"
    },
    "content_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Content Sha256",
      "type": "string"
    },
    "group_id": {
      "pattern": "^group-[a-z0-9-]{3,80}$",
      "title": "Group Id",
      "type": "string"
    },
    "language": {
      "enum": [
        "en",
        "zh"
      ],
      "title": "Language",
      "type": "string"
    },
    "license": {
      "const": "Apache-2.0",
      "default": "Apache-2.0",
      "title": "License",
      "type": "string"
    },
    "messages": {
      "items": {
        "$ref": "#/$defs/M10DevOpsTrainingMessage"
      },
      "maxItems": 12,
      "minItems": 3,
      "title": "Messages",
      "type": "array"
    },
    "mode": {
      "const": "nonthinking",
      "default": "nonthinking",
      "title": "Mode",
      "type": "string"
    },
    "prompt_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Prompt Sha256",
      "type": "string"
    },
    "sample_id": {
      "pattern": "^m10-devops-(?:en|zh)-[a-z0-9-]+-[0-9]{4}$",
      "title": "Sample Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_id": {
      "const": "tinyllm_devops",
      "default": "tinyllm_devops",
      "title": "Source Id",
      "type": "string"
    },
    "source_record_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source Record Sha256",
      "type": "string"
    },
    "source_revision": {
      "default": "m10-devops-training-v1",
      "enum": [
        "m10-devops-training-v1",
        "m10-devops-training-v2",
        "m10-devops-training-v3"
      ],
      "title": "Source Revision",
      "type": "string"
    },
    "template_family": {
      "pattern": "^family-[a-z0-9-]{3,80}$",
      "title": "Template Family",
      "type": "string"
    },
    "tool_schema_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Tool Schema Sha256",
      "type": "string"
    }
  },
  "required": [
    "sample_id",
    "language",
    "category",
    "template_family",
    "group_id",
    "available_tools",
    "messages",
    "source_record_sha256",
    "prompt_sha256",
    "tool_schema_sha256",
    "content_sha256"
  ],
  "title": "M10DevOpsTrainingSample",
  "type": "object"
}

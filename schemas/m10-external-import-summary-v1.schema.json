{
  "additionalProperties": false,
  "description": "Path-free public summary for one private canonical import.",
  "properties": {
    "accepted_rows": {
      "minimum": 0,
      "title": "Accepted Rows",
      "type": "integer"
    },
    "content_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Content Sha256",
      "type": "string"
    },
    "import_version": {
      "pattern": "^m10-(?:toolace|hermes)-canonical-v1-[0-9a-f]{8}$",
      "title": "Import Version",
      "type": "string"
    },
    "language_counts": {
      "additionalProperties": {
        "type": "integer"
      },
      "propertyNames": {
        "enum": [
          "en",
          "zh"
        ]
      },
      "title": "Language Counts",
      "type": "object"
    },
    "manifest_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Manifest Sha256",
      "type": "string"
    },
    "masked_messages": {
      "minimum": 0,
      "title": "Masked Messages",
      "type": "integer"
    },
    "rejected_rows": {
      "minimum": 0,
      "title": "Rejected Rows",
      "type": "integer"
    },
    "rejection_counts": {
      "additionalProperties": {
        "type": "integer"
      },
      "propertyNames": {
        "enum": [
          "invalid_row_shape",
          "invalid_role_path",
          "invalid_tool_schema",
          "malformed_tool_call",
          "unpaired_tool_result",
          "visible_reasoning"
        ]
      },
      "title": "Rejection Counts",
      "type": "object"
    },
    "source_id": {
      "enum": [
        "toolace",
        "hermes_function_calling"
      ],
      "title": "Source Id",
      "type": "string"
    },
    "source_rows": {
      "exclusiveMinimum": 0,
      "title": "Source Rows",
      "type": "integer"
    },
    "supervised_messages": {
      "minimum": 0,
      "title": "Supervised Messages",
      "type": "integer"
    },
    "tool_calls": {
      "minimum": 0,
      "title": "Tool Calls",
      "type": "integer"
    }
  },
  "required": [
    "source_id",
    "import_version",
    "manifest_sha256",
    "content_sha256",
    "source_rows",
    "accepted_rows",
    "rejected_rows",
    "rejection_counts",
    "language_counts",
    "supervised_messages",
    "masked_messages",
    "tool_calls"
  ],
  "title": "M10ExternalImportSummary",
  "type": "object"
}

{
  "$defs": {
    "M10StageExport": {
      "additionalProperties": false,
      "description": "Immutable model export for one evaluated M10 stage.",
      "properties": {
        "checkpoint_id": {
          "pattern": "^checkpoint-tokens-[0-9]{10}$",
          "title": "Checkpoint Id",
          "type": "string"
        },
        "export_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Export Sha256",
          "type": "string"
        },
        "supervised_tokens": {
          "enum": [
            1000000,
            5000000,
            10000000
          ],
          "title": "Supervised Tokens",
          "type": "integer"
        }
      },
      "required": [
        "checkpoint_id",
        "supervised_tokens",
        "export_sha256"
      ],
      "title": "M10StageExport",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Path-free result for one fresh or resumed M10 stage attempt.",
  "properties": {
    "attention_architecture": {
      "const": "gqa",
      "title": "Attention Architecture",
      "type": "string"
    },
    "completed_epochs": {
      "maximum": 10,
      "minimum": 1,
      "title": "Completed Epochs",
      "type": "integer"
    },
    "config_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Config Sha256",
      "type": "string"
    },
    "continuation_gate_sha256": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Continuation Gate Sha256"
    },
    "dataset_manifest_sha256": {
      "const": "6ec41bdee5d6509cbd04c6f4a0c1c7af2fa0ef116de185d9c43e2076d1ee0490",
      "title": "Dataset Manifest Sha256",
      "type": "string"
    },
    "dataset_version": {
      "const": "m10-agent-sft-v1-4655d3e3",
      "title": "Dataset Version",
      "type": "string"
    },
    "duration_seconds": {
      "exclusiveMinimum": 0,
      "title": "Duration Seconds",
      "type": "number"
    },
    "final_loss": {
      "exclusiveMinimum": 0,
      "title": "Final Loss",
      "type": "number"
    },
    "git_commit": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Git Commit",
      "type": "string"
    },
    "git_dirty": {
      "const": false,
      "title": "Git Dirty",
      "type": "boolean"
    },
    "global_step": {
      "exclusiveMinimum": 0,
      "title": "Global Step",
      "type": "integer"
    },
    "gpu_name": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Gpu Name",
      "type": "string"
    },
    "initial_loss": {
      "exclusiveMinimum": 0,
      "title": "Initial Loss",
      "type": "number"
    },
    "latest_checkpoint": {
      "pattern": "^checkpoint-tokens-[0-9]{10}$",
      "title": "Latest Checkpoint",
      "type": "string"
    },
    "mode": {
      "enum": [
        "fresh",
        "exact_resume"
      ],
      "title": "Mode",
      "type": "string"
    },
    "parent_model_artifact_sha256": {
      "const": "63db3b5f6ce0f12224167635fc8d67c53c32d7922caba3d65ac20c950f07dde6",
      "title": "Parent Model Artifact Sha256",
      "type": "string"
    },
    "parent_production_record_sha256": {
      "const": "a83eaff5e9b91be403bddb7a4ac23926465e0a78872921429dad72b6ee7d0ca5",
      "title": "Parent Production Record Sha256",
      "type": "string"
    },
    "parent_production_version": {
      "const": "qwen3-0-6b-m7-fa678d92",
      "title": "Parent Production Version",
      "type": "string"
    },
    "peak_allocated_bytes": {
      "exclusiveMinimum": 0,
      "title": "Peak Allocated Bytes",
      "type": "integer"
    },
    "peak_reserved_bytes": {
      "exclusiveMinimum": 0,
      "title": "Peak Reserved Bytes",
      "type": "integer"
    },
    "physical_gpu_index": {
      "minimum": 0,
      "title": "Physical Gpu Index",
      "type": "integer"
    },
    "resumed_from_tokens": {
      "anyOf": [
        {
          "maximum": 5000000,
          "minimum": 1000000,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Resumed From Tokens"
    },
    "run_id": {
      "maxLength": 180,
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "seed": {
      "const": 42,
      "title": "Seed",
      "type": "integer"
    },
    "stage_export": {
      "$ref": "#/$defs/M10StageExport"
    },
    "status": {
      "enum": [
        "stage_completed",
        "succeeded"
      ],
      "title": "Status",
      "type": "string"
    },
    "supervised_tokens": {
      "enum": [
        1000000,
        5000000,
        10000000
      ],
      "title": "Supervised Tokens",
      "type": "integer"
    }
  },
  "required": [
    "status",
    "mode",
    "run_id",
    "config_sha256",
    "git_commit",
    "git_dirty",
    "dataset_version",
    "dataset_manifest_sha256",
    "parent_production_version",
    "parent_production_record_sha256",
    "parent_model_artifact_sha256",
    "attention_architecture",
    "seed",
    "physical_gpu_index",
    "gpu_name",
    "global_step",
    "completed_epochs",
    "supervised_tokens",
    "initial_loss",
    "final_loss",
    "duration_seconds",
    "peak_allocated_bytes",
    "peak_reserved_bytes",
    "latest_checkpoint",
    "stage_export"
  ],
  "title": "M10FullSFTRunResult",
  "type": "object"
}

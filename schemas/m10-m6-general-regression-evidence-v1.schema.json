{
  "additionalProperties": false,
  "description": "Paired M6 general-capability evidence used only by the 5M continuation gate.",
  "properties": {
    "candidate_aggregate_basis_points": {
      "maximum": 10000,
      "minimum": 0,
      "title": "Candidate Aggregate Basis Points",
      "type": "integer"
    },
    "candidate_evaluation_subject_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Candidate Evaluation Subject Sha256",
      "type": "string"
    },
    "candidate_model_artifact_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Candidate Model Artifact Sha256",
      "type": "string"
    },
    "candidate_subject_id": {
      "pattern": "^qwen3-0-6b-m10-full-sft-5m-[0-9a-f]{8}$",
      "title": "Candidate Subject Id",
      "type": "string"
    },
    "candidate_summary_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Candidate Summary Sha256",
      "type": "string"
    },
    "evaluated_at": {
      "format": "date-time",
      "title": "Evaluated At",
      "type": "string"
    },
    "evidence_version": {
      "const": "m10-m6-general-regression-v1",
      "default": "m10-m6-general-regression-v1",
      "title": "Evidence Version",
      "type": "string"
    },
    "parent_aggregate_basis_points": {
      "maximum": 10000,
      "minimum": 0,
      "title": "Parent Aggregate Basis Points",
      "type": "integer"
    },
    "parent_model_artifact_sha256": {
      "const": "63db3b5f6ce0f12224167635fc8d67c53c32d7922caba3d65ac20c950f07dde6",
      "title": "Parent Model Artifact Sha256",
      "type": "string"
    },
    "parent_model_version": {
      "const": "qwen3-0-6b-m7-fa678d92",
      "title": "Parent Model Version",
      "type": "string"
    },
    "parent_summary_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Parent Summary Sha256",
      "type": "string"
    },
    "protocol_version": {
      "const": "m6-release-v7",
      "title": "Protocol Version",
      "type": "string"
    },
    "regression_basis_points": {
      "maximum": 10000,
      "minimum": -10000,
      "title": "Regression Basis Points",
      "type": "integer"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "evaluated_at",
    "protocol_version",
    "parent_model_version",
    "parent_model_artifact_sha256",
    "parent_summary_sha256",
    "parent_aggregate_basis_points",
    "candidate_subject_id",
    "candidate_evaluation_subject_sha256",
    "candidate_model_artifact_sha256",
    "candidate_summary_sha256",
    "candidate_aggregate_basis_points",
    "regression_basis_points"
  ],
  "title": "M10M6RegressionEvidence",
  "type": "object"
}

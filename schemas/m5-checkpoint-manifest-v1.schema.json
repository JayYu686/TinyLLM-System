{
  "$defs": {
    "M5CheckpointFile": {
      "additionalProperties": false,
      "description": "One integrity-checked file in an M5 single-GPU training Checkpoint.",
      "properties": {
        "path": {
          "const": "training_state.pt",
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "exclusiveMinimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "size_bytes",
        "sha256"
      ],
      "title": "M5CheckpointFile",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Atomic M5 exact-resume Checkpoint identity and progress.",
  "properties": {
    "checkpoint_id": {
      "pattern": "^checkpoint-tokens-[0-9]{10}$",
      "title": "Checkpoint Id",
      "type": "string"
    },
    "config_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Config Sha256",
      "type": "string"
    },
    "file": {
      "$ref": "#/$defs/M5CheckpointFile"
    },
    "git_commit": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Git Commit",
      "type": "string"
    },
    "global_step": {
      "minimum": 0,
      "title": "Global Step",
      "type": "integer"
    },
    "mixture_manifest_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Mixture Manifest Sha256",
      "type": "string"
    },
    "mixture_version": {
      "pattern": "^m5-(?:(?:ablation|format-repair)-mixture-v1|r3-mixture-v2)-[0-9a-f]{8}$",
      "title": "Mixture Version",
      "type": "string"
    },
    "model_revision": {
      "const": "c1899de289a04d12100db370d81485cdf75e47ca",
      "title": "Model Revision",
      "type": "string"
    },
    "pin_reason": {
      "anyOf": [
        {
          "enum": [
            "interruption",
            "final"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pin Reason"
    },
    "pinned": {
      "title": "Pinned",
      "type": "boolean"
    },
    "resume_capability": {
      "const": "exact",
      "default": "exact",
      "title": "Resume Capability",
      "type": "string"
    },
    "run_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "sequence_cursor": {
      "minimum": 0,
      "title": "Sequence Cursor",
      "type": "integer"
    },
    "strategy": {
      "const": "single",
      "default": "single",
      "title": "Strategy",
      "type": "string"
    },
    "supervised_tokens": {
      "maximum": 1000000,
      "minimum": 0,
      "title": "Supervised Tokens",
      "type": "integer"
    },
    "world_size": {
      "const": 1,
      "default": 1,
      "title": "World Size",
      "type": "integer"
    }
  },
  "required": [
    "checkpoint_id",
    "run_id",
    "global_step",
    "sequence_cursor",
    "supervised_tokens",
    "config_sha256",
    "mixture_version",
    "mixture_manifest_sha256",
    "model_revision",
    "git_commit",
    "file",
    "pinned"
  ],
  "title": "M5CheckpointManifest",
  "type": "object"
}

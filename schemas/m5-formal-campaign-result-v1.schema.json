{
  "$defs": {
    "M5FormalStagedEvaluation": {
      "additionalProperties": false,
      "description": "One real dual-mode Dev result from a staged Full-SFT export.",
      "properties": {
        "checkpoint_id": {
          "pattern": "^checkpoint-tokens-[0-9]{10}$",
          "title": "Checkpoint Id",
          "type": "string"
        },
        "evaluation_id": {
          "maxLength": 180,
          "minLength": 1,
          "title": "Evaluation Id",
          "type": "string"
        },
        "nonthinking_score_basis_points": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Nonthinking Score Basis Points",
          "type": "integer"
        },
        "snapshot_export_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Snapshot Export Sha256",
          "type": "string"
        },
        "summary_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Summary Sha256",
          "type": "string"
        },
        "supervised_tokens": {
          "maximum": 50000000,
          "minimum": 10000000,
          "title": "Supervised Tokens",
          "type": "integer"
        },
        "target_tokens": {
          "enum": [
            10000000,
            20000000,
            30000000,
            40000000,
            50000000
          ],
          "title": "Target Tokens",
          "type": "integer"
        },
        "thinking_controlled_format_basis_points": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Thinking Controlled Format Basis Points",
          "type": "integer"
        },
        "thinking_forced_close_basis_points": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Thinking Forced Close Basis Points",
          "type": "integer"
        },
        "thinking_natural_close_basis_points": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Thinking Natural Close Basis Points",
          "type": "integer"
        },
        "thinking_score_basis_points": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Thinking Score Basis Points",
          "type": "integer"
        }
      },
      "required": [
        "checkpoint_id",
        "target_tokens",
        "supervised_tokens",
        "snapshot_export_sha256",
        "evaluation_id",
        "summary_sha256",
        "thinking_controlled_format_basis_points",
        "thinking_natural_close_basis_points",
        "thinking_forced_close_basis_points",
        "thinking_score_basis_points",
        "nonthinking_score_basis_points"
      ],
      "title": "M5FormalStagedEvaluation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Path-free result for the two-segment four-GPU Full-SFT campaign.",
  "properties": {
    "campaign_id": {
      "pattern": "^[0-9]{8}T[0-9]{6}Z-m5-formal-campaign$",
      "title": "Campaign Id",
      "type": "string"
    },
    "evaluation_id": {
      "maxLength": 180,
      "minLength": 1,
      "title": "Evaluation Id",
      "type": "string"
    },
    "evaluation_summary_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Evaluation Summary Sha256",
      "type": "string"
    },
    "export_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Export Sha256",
      "type": "string"
    },
    "final_result_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Final Result Sha256",
      "type": "string"
    },
    "final_tokens": {
      "const": 50000000,
      "title": "Final Tokens",
      "type": "integer"
    },
    "git_commit": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Git Commit",
      "type": "string"
    },
    "interrupted_result_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Interrupted Result Sha256",
      "type": "string"
    },
    "interruption_tokens": {
      "exclusiveMaximum": 2100000,
      "minimum": 2000000,
      "title": "Interruption Tokens",
      "type": "integer"
    },
    "max_observed_temperature_c": {
      "maximum": 100,
      "minimum": 0,
      "title": "Max Observed Temperature C",
      "type": "integer"
    },
    "nonthinking_score_basis_points": {
      "maximum": 10000,
      "minimum": 0,
      "title": "Nonthinking Score Basis Points",
      "type": "integer"
    },
    "physical_gpu_indices": {
      "maxItems": 4,
      "minItems": 4,
      "prefixItems": [
        {
          "type": "integer"
        },
        {
          "type": "integer"
        },
        {
          "type": "integer"
        },
        {
          "type": "integer"
        }
      ],
      "title": "Physical Gpu Indices",
      "type": "array"
    },
    "resumed_from_tokens": {
      "exclusiveMaximum": 2100000,
      "minimum": 2000000,
      "title": "Resumed From Tokens",
      "type": "integer"
    },
    "run_id": {
      "maxLength": 180,
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "segment_count": {
      "const": 2,
      "title": "Segment Count",
      "type": "integer"
    },
    "staged_evaluations": {
      "maxItems": 5,
      "minItems": 5,
      "prefixItems": [
        {
          "$ref": "#/$defs/M5FormalStagedEvaluation"
        },
        {
          "$ref": "#/$defs/M5FormalStagedEvaluation"
        },
        {
          "$ref": "#/$defs/M5FormalStagedEvaluation"
        },
        {
          "$ref": "#/$defs/M5FormalStagedEvaluation"
        },
        {
          "$ref": "#/$defs/M5FormalStagedEvaluation"
        }
      ],
      "title": "Staged Evaluations",
      "type": "array"
    },
    "status": {
      "const": "succeeded",
      "title": "Status",
      "type": "string"
    },
    "thermal_events_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Thermal Events Sha256",
      "type": "string"
    },
    "thermal_pause_count": {
      "minimum": 0,
      "title": "Thermal Pause Count",
      "type": "integer"
    },
    "thinking_controlled_format_basis_points": {
      "maximum": 10000,
      "minimum": 0,
      "title": "Thinking Controlled Format Basis Points",
      "type": "integer"
    },
    "thinking_forced_close_basis_points": {
      "maximum": 10000,
      "minimum": 0,
      "title": "Thinking Forced Close Basis Points",
      "type": "integer"
    },
    "thinking_natural_close_basis_points": {
      "maximum": 10000,
      "minimum": 0,
      "title": "Thinking Natural Close Basis Points",
      "type": "integer"
    },
    "thinking_score_basis_points": {
      "maximum": 10000,
      "minimum": 0,
      "title": "Thinking Score Basis Points",
      "type": "integer"
    }
  },
  "required": [
    "status",
    "campaign_id",
    "run_id",
    "physical_gpu_indices",
    "segment_count",
    "interruption_tokens",
    "resumed_from_tokens",
    "final_tokens",
    "export_sha256",
    "interrupted_result_sha256",
    "final_result_sha256",
    "evaluation_id",
    "evaluation_summary_sha256",
    "thinking_controlled_format_basis_points",
    "thinking_natural_close_basis_points",
    "thinking_forced_close_basis_points",
    "thinking_score_basis_points",
    "nonthinking_score_basis_points",
    "staged_evaluations",
    "thermal_events_sha256",
    "thermal_pause_count",
    "max_observed_temperature_c",
    "git_commit"
  ],
  "title": "M5FormalCampaignResult",
  "type": "object"
}

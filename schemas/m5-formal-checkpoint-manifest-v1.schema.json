{
  "$defs": {
    "M5FormalCheckpointFile": {
      "additionalProperties": false,
      "description": "One integrity-checked complete DDP training state.",
      "properties": {
        "path": {
          "const": "training_state.pt",
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "exclusiveMinimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "size_bytes",
        "sha256"
      ],
      "title": "M5FormalCheckpointFile",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Atomic exact-resume point at an optimizer boundary.",
  "properties": {
    "checkpoint_id": {
      "pattern": "^checkpoint-tokens-[0-9]{10}$",
      "title": "Checkpoint Id",
      "type": "string"
    },
    "config_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Config Sha256",
      "type": "string"
    },
    "dataset_manifest_sha256": {
      "const": "607b3b1a73ae03d5f183f11d8c4824b04243ed30f6352567ce7bd7a972c962f6",
      "title": "Dataset Manifest Sha256",
      "type": "string"
    },
    "dataset_version": {
      "const": "m5-dual-sft-v1-b5b9e839",
      "title": "Dataset Version",
      "type": "string"
    },
    "file": {
      "$ref": "#/$defs/M5FormalCheckpointFile"
    },
    "git_commit": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Git Commit",
      "type": "string"
    },
    "global_step": {
      "minimum": 0,
      "title": "Global Step",
      "type": "integer"
    },
    "local_sequence_cursor": {
      "minimum": 0,
      "title": "Local Sequence Cursor",
      "type": "integer"
    },
    "model_revision": {
      "const": "c1899de289a04d12100db370d81485cdf75e47ca",
      "title": "Model Revision",
      "type": "string"
    },
    "pin_reason": {
      "anyOf": [
        {
          "enum": [
            "interruption",
            "evaluation",
            "final"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pin Reason"
    },
    "pinned": {
      "title": "Pinned",
      "type": "boolean"
    },
    "resume_capability": {
      "const": "exact",
      "default": "exact",
      "title": "Resume Capability",
      "type": "string"
    },
    "run_id": {
      "maxLength": 180,
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "strategy": {
      "const": "ddp",
      "default": "ddp",
      "title": "Strategy",
      "type": "string"
    },
    "supervised_tokens": {
      "maximum": 50000000,
      "minimum": 0,
      "title": "Supervised Tokens",
      "type": "integer"
    },
    "world_size": {
      "const": 4,
      "default": 4,
      "title": "World Size",
      "type": "integer"
    }
  },
  "required": [
    "checkpoint_id",
    "run_id",
    "global_step",
    "local_sequence_cursor",
    "supervised_tokens",
    "config_sha256",
    "dataset_version",
    "dataset_manifest_sha256",
    "model_revision",
    "git_commit",
    "file",
    "pinned"
  ],
  "title": "M5FormalCheckpointManifest",
  "type": "object"
}

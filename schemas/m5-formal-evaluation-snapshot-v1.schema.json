{
  "additionalProperties": false,
  "description": "One immutable inference export bound to a staged Full-SFT Checkpoint.",
  "properties": {
    "checkpoint_id": {
      "pattern": "^checkpoint-tokens-[0-9]{10}$",
      "title": "Checkpoint Id",
      "type": "string"
    },
    "checkpoint_manifest_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Checkpoint Manifest Sha256",
      "type": "string"
    },
    "export_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Export Sha256",
      "type": "string"
    },
    "git_commit": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Git Commit",
      "type": "string"
    },
    "model_revision": {
      "const": "c1899de289a04d12100db370d81485cdf75e47ca",
      "title": "Model Revision",
      "type": "string"
    },
    "run_id": {
      "maxLength": 180,
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "supervised_tokens": {
      "enum": [
        10000000,
        20000000,
        30000000,
        40000000,
        50000000
      ],
      "title": "Supervised Tokens",
      "type": "integer"
    }
  },
  "required": [
    "run_id",
    "checkpoint_id",
    "supervised_tokens",
    "checkpoint_manifest_sha256",
    "export_sha256",
    "model_revision",
    "git_commit"
  ],
  "title": "M5FormalEvaluationSnapshot",
  "type": "object"
}

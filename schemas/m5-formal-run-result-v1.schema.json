{
  "$defs": {
    "M5FormalRankMemory": {
      "additionalProperties": false,
      "description": "Peak CUDA memory from one training Rank.",
      "properties": {
        "gpu_name": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Gpu Name",
          "type": "string"
        },
        "peak_allocated_bytes": {
          "exclusiveMinimum": 0,
          "title": "Peak Allocated Bytes",
          "type": "integer"
        },
        "peak_reserved_bytes": {
          "exclusiveMinimum": 0,
          "title": "Peak Reserved Bytes",
          "type": "integer"
        },
        "physical_gpu_index": {
          "minimum": 0,
          "title": "Physical Gpu Index",
          "type": "integer"
        },
        "rank": {
          "maximum": 3,
          "minimum": 0,
          "title": "Rank",
          "type": "integer"
        }
      },
      "required": [
        "rank",
        "physical_gpu_index",
        "gpu_name",
        "peak_allocated_bytes",
        "peak_reserved_bytes"
      ],
      "title": "M5FormalRankMemory",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Path-free result for one fresh or Exact-Resume Full-SFT attempt.",
  "properties": {
    "attention_architecture": {
      "const": "gqa",
      "title": "Attention Architecture",
      "type": "string"
    },
    "completed_dataset_epochs": {
      "exclusiveMinimum": 0.0,
      "maximum": 50.0,
      "title": "Completed Dataset Epochs",
      "type": "number"
    },
    "config_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Config Sha256",
      "type": "string"
    },
    "dataset_manifest_sha256": {
      "const": "607b3b1a73ae03d5f183f11d8c4824b04243ed30f6352567ce7bd7a972c962f6",
      "title": "Dataset Manifest Sha256",
      "type": "string"
    },
    "dataset_version": {
      "const": "m5-dual-sft-v1-b5b9e839",
      "title": "Dataset Version",
      "type": "string"
    },
    "duration_seconds": {
      "exclusiveMinimum": 0,
      "title": "Duration Seconds",
      "type": "number"
    },
    "environment_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Environment Sha256",
      "type": "string"
    },
    "evaluation_checkpoints": {
      "items": {
        "type": "string"
      },
      "title": "Evaluation Checkpoints",
      "type": "array"
    },
    "evaluation_export_sha256s": {
      "items": {
        "type": "string"
      },
      "title": "Evaluation Export Sha256S",
      "type": "array"
    },
    "export_sha256": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Export Sha256"
    },
    "final_loss": {
      "exclusiveMinimum": 0,
      "title": "Final Loss",
      "type": "number"
    },
    "git_commit": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Git Commit",
      "type": "string"
    },
    "git_dirty": {
      "const": false,
      "title": "Git Dirty",
      "type": "boolean"
    },
    "global_step": {
      "exclusiveMinimum": 0,
      "title": "Global Step",
      "type": "integer"
    },
    "hardware_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Hardware Sha256",
      "type": "string"
    },
    "initial_loss": {
      "exclusiveMinimum": 0,
      "title": "Initial Loss",
      "type": "number"
    },
    "latest_checkpoint": {
      "pattern": "^checkpoint-tokens-[0-9]{10}$",
      "title": "Latest Checkpoint",
      "type": "string"
    },
    "local_sequence_cursor": {
      "exclusiveMinimum": 0,
      "title": "Local Sequence Cursor",
      "type": "integer"
    },
    "mode": {
      "enum": [
        "fresh",
        "exact_resume"
      ],
      "title": "Mode",
      "type": "string"
    },
    "model_revision": {
      "const": "c1899de289a04d12100db370d81485cdf75e47ca",
      "title": "Model Revision",
      "type": "string"
    },
    "rank_memory": {
      "maxItems": 4,
      "minItems": 4,
      "prefixItems": [
        {
          "$ref": "#/$defs/M5FormalRankMemory"
        },
        {
          "$ref": "#/$defs/M5FormalRankMemory"
        },
        {
          "$ref": "#/$defs/M5FormalRankMemory"
        },
        {
          "$ref": "#/$defs/M5FormalRankMemory"
        }
      ],
      "title": "Rank Memory",
      "type": "array"
    },
    "resumed_from_tokens": {
      "anyOf": [
        {
          "exclusiveMaximum": 50000000,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Resumed From Tokens"
    },
    "run_id": {
      "maxLength": 180,
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "seed": {
      "maximum": 4294967295,
      "minimum": 0,
      "title": "Seed",
      "type": "integer"
    },
    "status": {
      "enum": [
        "succeeded",
        "interrupted"
      ],
      "title": "Status",
      "type": "string"
    },
    "supervised_tokens": {
      "exclusiveMinimum": 0,
      "maximum": 50000000,
      "title": "Supervised Tokens",
      "type": "integer"
    },
    "thinking_fraction_basis_points": {
      "const": 3000,
      "title": "Thinking Fraction Basis Points",
      "type": "integer"
    },
    "world_size": {
      "const": 4,
      "title": "World Size",
      "type": "integer"
    }
  },
  "required": [
    "status",
    "mode",
    "run_id",
    "config_sha256",
    "git_commit",
    "git_dirty",
    "environment_sha256",
    "hardware_sha256",
    "model_revision",
    "attention_architecture",
    "dataset_version",
    "dataset_manifest_sha256",
    "thinking_fraction_basis_points",
    "seed",
    "world_size",
    "global_step",
    "local_sequence_cursor",
    "supervised_tokens",
    "completed_dataset_epochs",
    "initial_loss",
    "final_loss",
    "duration_seconds",
    "rank_memory",
    "latest_checkpoint",
    "evaluation_checkpoints",
    "evaluation_export_sha256s"
  ],
  "title": "M5FormalRunResult",
  "type": "object"
}

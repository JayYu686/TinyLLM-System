  "required": [
    "checkpoint_id",
    "supervised_tokens",
    "snapshot_export_sha256",
    "evaluation_id",
    "summary_sha256",
    "thinking_controlled_format_basis_points",
    "thinking_natural_close_basis_points",
    "thinking_forced_close_basis_points",
    "thinking_score_basis_points",

{
  "$defs": {
    "M5MixtureArtifactFile": {
      "additionalProperties": false,
      "description": "One immutable private mixture payload.",
      "properties": {
        "path": {
          "const": "sequences.npz",
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "exclusiveMinimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "size_bytes",
        "sha256"
      ],
      "title": "M5MixtureArtifactFile",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Content-addressed R1 mixture with separately auditable repair supervision.",
  "properties": {
    "artifact": {
      "$ref": "#/$defs/M5MixtureArtifactFile"
    },
    "build_seed": {
      "maximum": 4294967295,
      "minimum": 0,
      "title": "Build Seed",
      "type": "integer"
    },
    "content_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Content Sha256",
      "type": "string"
    },
    "dataset_name": {
      "const": "m5-format-repair-mixture",
      "default": "m5-format-repair-mixture",
      "title": "Dataset Name",
      "type": "string"
    },
    "general_thinking_reuse_count": {
      "minimum": 0,
      "title": "General Thinking Reuse Count",
      "type": "integer"
    },
    "general_thinking_sequence_count": {
      "exclusiveMinimum": 0,
      "title": "General Thinking Sequence Count",
      "type": "integer"
    },
    "general_thinking_source_sequences": {
      "exclusiveMinimum": 0,
      "title": "General Thinking Source Sequences",
      "type": "integer"
    },
    "general_thinking_supervised_tokens": {
      "const": 150000,
      "title": "General Thinking Supervised Tokens",
      "type": "integer"
    },
    "mixture_version": {
      "pattern": "^m5-format-repair-mixture-v1-[0-9a-f]{8}$",
      "title": "Mixture Version",
      "type": "string"
    },
    "nonthinking_reuse_count": {
      "minimum": 0,
      "title": "Nonthinking Reuse Count",
      "type": "integer"
    },
    "nonthinking_sequence_count": {
      "exclusiveMinimum": 0,
      "title": "Nonthinking Sequence Count",
      "type": "integer"
    },
    "nonthinking_source_sequences": {
      "exclusiveMinimum": 0,
      "title": "Nonthinking Source Sequences",
      "type": "integer"
    },
    "nonthinking_supervised_tokens": {
      "const": 700000,
      "title": "Nonthinking Supervised Tokens",
      "type": "integer"
    },
    "nonthinking_template_id": {
      "const": "qwen3-chatml-nonthinking-v1",
      "title": "Nonthinking Template Id",
      "type": "string"
    },
    "pad_token_id": {
      "const": 151643,
      "title": "Pad Token Id",
      "type": "integer"
    },
    "parent_content_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Parent Content Sha256",
      "type": "string"
    },
    "parent_dataset_version": {
      "const": "m2-sft-v1-f82ff32e",
      "title": "Parent Dataset Version",
      "type": "string"
    },
    "partially_masked_sequences": {
      "maximum": 3,
      "minimum": 0,
      "title": "Partially Masked Sequences",
      "type": "integer"
    },
    "pilot_content_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Pilot Content Sha256",
      "type": "string"
    },
    "pilot_dataset_version": {
      "pattern": "^m5-reasoning-pilot-v1-[0-9a-f]{8}$",
      "title": "Pilot Dataset Version",
      "type": "string"
    },
    "repair_max_supervised_tokens": {
      "const": 512,
      "title": "Repair Max Supervised Tokens",
      "type": "integer"
    },
    "repair_policy_id": {
      "const": "short-complete-balanced-v1",
      "title": "Repair Policy Id",
      "type": "string"
    },
    "repair_source_family_counts": {
      "additionalProperties": {
        "type": "integer"
      },
      "propertyNames": {
        "enum": [
          "config",
          "json",
          "linux",
          "log_diagnosis",
          "python"
        ]
      },
      "title": "Repair Source Family Counts",
      "type": "object"
    },
    "repair_source_language_counts": {
      "additionalProperties": {
        "type": "integer"
      },
      "propertyNames": {
        "enum": [
          "en",
          "zh"
        ]
      },
      "title": "Repair Source Language Counts",
      "type": "object"
    },
    "repair_source_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Repair Source Sha256",
      "type": "string"
    },
    "repair_thinking_reuse_count": {
      "minimum": 0,
      "title": "Repair Thinking Reuse Count",
      "type": "integer"
    },
    "repair_thinking_sequence_count": {
      "exclusiveMinimum": 0,
      "title": "Repair Thinking Sequence Count",
      "type": "integer"
    },
    "repair_thinking_source_sequences": {
      "const": 40,
      "title": "Repair Thinking Source Sequences",
      "type": "integer"
    },
    "repair_thinking_supervised_tokens": {
      "const": 150000,
      "title": "Repair Thinking Supervised Tokens",
      "type": "integer"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "sequence_count": {
      "exclusiveMinimum": 0,
      "title": "Sequence Count",
      "type": "integer"
    },
    "sequence_length": {
      "const": 1024,
      "title": "Sequence Length",
      "type": "integer"
    },
    "target_supervised_tokens": {
      "const": 1000000,
      "title": "Target Supervised Tokens",
      "type": "integer"
    },
    "thinking_fraction_basis_points": {
      "const": 3000,
      "title": "Thinking Fraction Basis Points",
      "type": "integer"
    },
    "thinking_sequence_count": {
      "exclusiveMinimum": 0,
      "title": "Thinking Sequence Count",
      "type": "integer"
    },
    "thinking_supervised_tokens": {
      "const": 300000,
      "title": "Thinking Supervised Tokens",
      "type": "integer"
    },
    "thinking_template_id": {
      "const": "qwen3-chatml-thinking-v1",
      "title": "Thinking Template Id",
      "type": "string"
    },
    "tokenizer_revision": {
      "const": "c1899de289a04d12100db370d81485cdf75e47ca",
      "title": "Tokenizer Revision",
      "type": "string"
    }
  },
  "required": [
    "mixture_version",
    "parent_dataset_version",
    "parent_content_sha256",
    "pilot_dataset_version",
    "pilot_content_sha256",
    "tokenizer_revision",
    "nonthinking_template_id",
    "thinking_template_id",
    "sequence_length",
    "pad_token_id",
    "target_supervised_tokens",
    "thinking_fraction_basis_points",
    "nonthinking_supervised_tokens",
    "thinking_supervised_tokens",
    "general_thinking_supervised_tokens",
    "repair_thinking_supervised_tokens",
    "sequence_count",
    "nonthinking_sequence_count",
    "thinking_sequence_count",
    "general_thinking_sequence_count",
    "repair_thinking_sequence_count",
    "nonthinking_source_sequences",
    "general_thinking_source_sequences",
    "repair_thinking_source_sequences",
    "nonthinking_reuse_count",
    "general_thinking_reuse_count",
    "repair_thinking_reuse_count",
    "partially_masked_sequences",
    "repair_policy_id",
    "repair_max_supervised_tokens",
    "repair_source_family_counts",
    "repair_source_language_counts",
    "repair_source_sha256",
    "build_seed",
    "content_sha256",
    "artifact"
  ],
  "title": "M5FormatRepairMixtureManifest",
  "type": "object"
}

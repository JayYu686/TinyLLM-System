{
  "additionalProperties": false,
  "description": "Path-free result for the reviewed two-segment formal LoRA campaign.",
  "properties": {
    "adapter_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Adapter Sha256",
      "type": "string"
    },
    "campaign_id": {
      "pattern": "^[0-9]{8}T[0-9]{6}Z-m5-lora-campaign-gpu[0-9]+$",
      "title": "Campaign Id",
      "type": "string"
    },
    "final_result_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Final Result Sha256",
      "type": "string"
    },
    "final_tokens": {
      "const": 10000000,
      "title": "Final Tokens",
      "type": "integer"
    },
    "git_commit": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Git Commit",
      "type": "string"
    },
    "interrupted_result_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Interrupted Result Sha256",
      "type": "string"
    },
    "interruption_tokens": {
      "exclusiveMaximum": 5100000,
      "minimum": 5000000,
      "title": "Interruption Tokens",
      "type": "integer"
    },
    "max_observed_temperature_c": {
      "maximum": 100,
      "minimum": 0,
      "title": "Max Observed Temperature C",
      "type": "integer"
    },
    "physical_gpu_index": {
      "minimum": 0,
      "title": "Physical Gpu Index",
      "type": "integer"
    },
    "resumed_from_tokens": {
      "exclusiveMaximum": 5100000,
      "minimum": 5000000,
      "title": "Resumed From Tokens",
      "type": "integer"
    },
    "run_id": {
      "maxLength": 180,
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "segment_count": {
      "const": 2,
      "title": "Segment Count",
      "type": "integer"
    },
    "status": {
      "const": "succeeded",
      "title": "Status",
      "type": "string"
    },
    "thermal_events_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Thermal Events Sha256",
      "type": "string"
    },
    "thermal_pause_count": {
      "minimum": 0,
      "title": "Thermal Pause Count",
      "type": "integer"
    }
  },
  "required": [
    "status",
    "campaign_id",
    "run_id",
    "physical_gpu_index",
    "segment_count",
    "interruption_tokens",
    "resumed_from_tokens",
    "final_tokens",
    "adapter_sha256",
    "interrupted_result_sha256",
    "final_result_sha256",
    "thermal_events_sha256",
    "thermal_pause_count",
    "max_observed_temperature_c",
    "git_commit"
  ],
  "title": "M5LoRACampaignResult",
  "type": "object"
}

{
  "$defs": {
    "M5R2OfflineSeedAnalysis": {
      "additionalProperties": false,
      "description": "One Seed's content-free D1 analysis of failures and matched successes.",
      "properties": {
        "failure_distribution": {
          "$ref": "#/$defs/M5R2RepetitionDistribution"
        },
        "finish_reason_counts": {
          "additionalProperties": {
            "maximum": 200,
            "minimum": 0,
            "type": "integer"
          },
          "propertyNames": {
            "enum": [
              "eos",
              "length"
            ]
          },
          "title": "Finish Reason Counts",
          "type": "object"
        },
        "invalid_format_items": {
          "exclusiveMinimum": 0,
          "maximum": 200,
          "title": "Invalid Format Items",
          "type": "integer"
        },
        "language_counts": {
          "additionalProperties": {
            "maximum": 200,
            "minimum": 0,
            "type": "integer"
          },
          "propertyNames": {
            "enum": [
              "en",
              "zh"
            ]
          },
          "title": "Language Counts",
          "type": "object"
        },
        "matched_valid_distribution": {
          "$ref": "#/$defs/M5R2RepetitionDistribution"
        },
        "matched_valid_items": {
          "exclusiveMinimum": 0,
          "maximum": 200,
          "title": "Matched Valid Items",
          "type": "integer"
        },
        "source_evaluation_id": {
          "maxLength": 180,
          "minLength": 1,
          "title": "Source Evaluation Id",
          "type": "string"
        },
        "source_raw_results_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Source Raw Results Sha256",
          "type": "string"
        },
        "task_family_counts": {
          "additionalProperties": {
            "maximum": 200,
            "minimum": 0,
            "type": "integer"
          },
          "propertyNames": {
            "enum": [
              "config",
              "json",
              "linux",
              "log_diagnosis",
              "python"
            ]
          },
          "title": "Task Family Counts",
          "type": "object"
        },
        "training_seed": {
          "enum": [
            42,
            20260727
          ],
          "title": "Training Seed",
          "type": "integer"
        }
      },
      "required": [
        "training_seed",
        "source_evaluation_id",
        "source_raw_results_sha256",
        "invalid_format_items",
        "task_family_counts",
        "language_counts",
        "finish_reason_counts",
        "failure_distribution",
        "matched_valid_items",
        "matched_valid_distribution"
      ],
      "title": "M5R2OfflineSeedAnalysis",
      "type": "object"
    },
    "M5R2RepetitionDistribution": {
      "additionalProperties": false,
      "description": "Content-free token-length and repetition distribution for one slice.",
      "properties": {
        "generated_tokens_max": {
          "exclusiveMinimum": 0,
          "maximum": 896,
          "title": "Generated Tokens Max",
          "type": "integer"
        },
        "generated_tokens_min": {
          "exclusiveMinimum": 0,
          "maximum": 896,
          "title": "Generated Tokens Min",
          "type": "integer"
        },
        "generated_tokens_p50": {
          "exclusiveMinimum": 0,
          "maximum": 896,
          "title": "Generated Tokens P50",
          "type": "number"
        },
        "generated_tokens_p90": {
          "exclusiveMinimum": 0,
          "maximum": 896,
          "title": "Generated Tokens P90",
          "type": "integer"
        },
        "items": {
          "exclusiveMinimum": 0,
          "maximum": 200,
          "title": "Items",
          "type": "integer"
        },
        "max_identical_line_hash_repetitions": {
          "exclusiveMinimum": 0,
          "title": "Max Identical Line Hash Repetitions",
          "type": "integer"
        },
        "repeated_8gram_ratio_mean_basis_points": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Repeated 8Gram Ratio Mean Basis Points",
          "type": "integer"
        },
        "unique_token_ratio_mean_basis_points": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Unique Token Ratio Mean Basis Points",
          "type": "integer"
        }
      },
      "required": [
        "items",
        "generated_tokens_min",
        "generated_tokens_p50",
        "generated_tokens_p90",
        "generated_tokens_max",
        "unique_token_ratio_mean_basis_points",
        "repeated_8gram_ratio_mean_basis_points",
        "max_identical_line_hash_repetitions"
      ],
      "title": "M5R2RepetitionDistribution",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Public two-Seed D1 result without response or task-level content.",
  "properties": {
    "analysis_version": {
      "const": "m5-r2-offline-analysis-v1",
      "title": "Analysis Version",
      "type": "string"
    },
    "evaluation_config_sha256": {
      "const": "3735a34e70c06059fbc09f62d02fabc296fd97e79a45d60f3d00dede21108d51",
      "title": "Evaluation Config Sha256",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "slices": {
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "$ref": "#/$defs/M5R2OfflineSeedAnalysis"
        },
        {
          "$ref": "#/$defs/M5R2OfflineSeedAnalysis"
        }
      ],
      "title": "Slices",
      "type": "array"
    },
    "status": {
      "const": "succeeded",
      "title": "Status",
      "type": "string"
    },
    "suite_version": {
      "const": "m5-reasoning-dev-v1-53ddf557",
      "title": "Suite Version",
      "type": "string"
    },
    "tokenizer_revision": {
      "const": "c1899de289a04d12100db370d81485cdf75e47ca",
      "title": "Tokenizer Revision",
      "type": "string"
    },
    "training_seeds": {
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "const": 42,
          "type": "integer"
        },
        {
          "const": 20260727,
          "type": "integer"
        }
      ],
      "title": "Training Seeds",
      "type": "array"
    }
  },
  "required": [
    "status",
    "analysis_version",
    "suite_version",
    "evaluation_config_sha256",
    "tokenizer_revision",
    "training_seeds",
    "slices"
  ],
  "title": "M5R2OfflineAnalysis",
  "type": "object"
}

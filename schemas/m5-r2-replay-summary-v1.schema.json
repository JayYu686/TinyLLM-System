      "type": "string"
    },
    "model_export_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Model Export Sha256",
      "type": "string"
    },
    "model_revision": {
      "const": "c1899de289a04d12100db370d81485cdf75e47ca",
      "title": "Model Revision",
      "type": "string"
    },
    "original_failed_items": {
      "exclusiveMinimum": 0,
      "maximum": 200,
      "title": "Original Failed Items",
      "type": "integer"
    },
    "peak_allocated_bytes": {
      "exclusiveMinimum": 0,
      "title": "Peak Allocated Bytes",
      "type": "integer"
    },
    "peak_reserved_bytes": {
      "exclusiveMinimum": 0,
      "title": "Peak Reserved Bytes",
      "type": "integer"
    },
    "physical_gpu_index": {
      "minimum": 0,
      "title": "Physical Gpu Index",
      "type": "integer"
    },
    "raw_results_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Raw Results Sha256",
      "type": "string"
    },
    "replay_1536_prefix_exact_items": {
      "exclusiveMinimum": 0,
      "maximum": 200,
      "title": "Replay 1536 Prefix Exact Items",
      "type": "integer"
    },
    "replay_896_exact_items": {
      "exclusiveMinimum": 0,
      "maximum": 200,
      "title": "Replay 896 Exact Items",
      "type": "integer"
    },
    "replayed_batches": {
      "exclusiveMinimum": 0,
      "maximum": 50,
      "title": "Replayed Batches",
      "type": "integer"
    },
    "replayed_items": {
      "exclusiveMinimum": 0,
      "maximum": 200,
      "title": "Replayed Items",
      "type": "integer"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_correct_items": {
      "maximum": 200,
      "minimum": 0,
      "title": "Source Correct Items",
      "type": "integer"
    },
    "source_evaluation_id": {
      "maxLength": 180,
      "minLength": 1,
      "title": "Source Evaluation Id",
      "type": "string"
    },
    "source_format_valid_items": {
      "maximum": 200,
      "minimum": 0,
      "title": "Source Format Valid Items",
      "type": "integer"
    },
    "source_raw_results_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source Raw Results Sha256",
      "type": "string"
    },
    "status": {
      "const": "succeeded",
      "title": "Status",
      "type": "string"
    },
    "suite_version": {
      "const": "m5-reasoning-dev-v1-53ddf557",
      "title": "Suite Version",
      "type": "string"
    },
    "thresholds": {
      "maxItems": 3,
      "minItems": 3,
      "prefixItems": [
        {
          "$ref": "#/$defs/M5R2ThresholdSummary"
        },
        {
          "$ref": "#/$defs/M5R2ThresholdSummary"
        },
        {
          "$ref": "#/$defs/M5R2ThresholdSummary"
        }
      ],
      "title": "Thresholds",
      "type": "array"
    },
    "training_run_id": {
      "maxLength": 180,
      "minLength": 1,
      "title": "Training Run Id",
      "type": "string"
    },
    "training_seed": {
      "enum": [
        42,
        20260727
      ],
      "title": "Training Seed",
      "type": "integer"
    }
  },
  "required": [
    "status",
    "diagnostic_id",
    "diagnostic_version",
    "diagnostic_config_sha256",
    "source_evaluation_id",
    "source_raw_results_sha256",
    "training_run_id",
    "training_seed",
    "mixture_version",
    "mixture_manifest_sha256",
    "model_export_sha256",
    "model_revision",
    "attention_architecture",
    "suite_version",
    "evaluation_config_sha256",
    "git_commit",
    "git_dirty",
    "physical_gpu_index",
    "gpu_name",
    "duration_seconds",
    "peak_allocated_bytes",
    "peak_reserved_bytes",
    "source_format_valid_items",
    "source_correct_items",
    "original_failed_items",
    "replayed_batches",
    "replayed_items",
    "replay_896_exact_items",
    "replay_1536_prefix_exact_items",
    "thresholds",
    "raw_results_sha256"

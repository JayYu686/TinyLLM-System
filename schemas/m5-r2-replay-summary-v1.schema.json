{
  "$defs": {
    "M5R2ThresholdSummary": {
      "additionalProperties": false,
      "description": "Content-free projected metrics for one counterfactual limit.",
      "properties": {
        "closing_tag_end_token_max": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 1536,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Closing Tag End Token Max"
        },
        "closing_tag_end_token_min": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 1536,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Closing Tag End Token Min"
        },
        "max_new_tokens": {
          "enum": [
            1024,
            1280,
            1536
          ],
          "title": "Max New Tokens",
          "type": "integer"
        },
        "original_failed_items": {
          "exclusiveMinimum": 0,
          "maximum": 200,
          "title": "Original Failed Items",
          "type": "integer"
        },
        "projected_correct_items": {
          "maximum": 200,
          "minimum": 0,
          "title": "Projected Correct Items",
          "type": "integer"
        },
        "projected_format_basis_points": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Projected Format Basis Points",
          "type": "integer"
        },
        "projected_format_valid_items": {
          "maximum": 200,
          "minimum": 0,
          "title": "Projected Format Valid Items",
          "type": "integer"
        },
        "projected_score_basis_points": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Projected Score Basis Points",
          "type": "integer"
        },
        "recovered_correct_items": {
          "maximum": 200,
          "minimum": 0,
          "title": "Recovered Correct Items",
          "type": "integer"
        },
        "recovered_final_json_items": {
          "maximum": 200,
          "minimum": 0,
          "title": "Recovered Final Json Items",
          "type": "integer"
        },
        "recovered_format_items": {
          "maximum": 200,
          "minimum": 0,
          "title": "Recovered Format Items",
          "type": "integer"
        },
        "unresolved_format_items": {
          "maximum": 200,
          "minimum": 0,
          "title": "Unresolved Format Items",
          "type": "integer"
        }
      },
      "required": [
        "max_new_tokens",
        "original_failed_items",
        "recovered_format_items",
        "recovered_final_json_items",
        "recovered_correct_items",
        "unresolved_format_items",
        "projected_format_valid_items",
        "projected_format_basis_points",
        "projected_correct_items",
        "projected_score_basis_points"
      ],
      "title": "M5R2ThresholdSummary",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Public, path-free result for one Candidate's R2 replay.",
  "properties": {
    "attention_architecture": {
      "const": "gqa",
      "title": "Attention Architecture",
      "type": "string"
    },
    "diagnostic_config_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Diagnostic Config Sha256",
      "type": "string"
    },
    "diagnostic_id": {
      "maxLength": 180,
      "minLength": 1,
      "title": "Diagnostic Id",
      "type": "string"
    },
    "diagnostic_version": {
      "const": "m5-r2-length-replay-v1",
      "title": "Diagnostic Version",
      "type": "string"
    },
    "duration_seconds": {
      "exclusiveMinimum": 0,
      "title": "Duration Seconds",
      "type": "number"
    },
    "evaluation_config_sha256": {
      "const": "3735a34e70c06059fbc09f62d02fabc296fd97e79a45d60f3d00dede21108d51",
      "title": "Evaluation Config Sha256",
      "type": "string"
    },
    "git_commit": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Git Commit",
      "type": "string"
    },
    "git_dirty": {
      "const": false,
      "title": "Git Dirty",
      "type": "boolean"
    },
    "gpu_name": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Gpu Name",
      "type": "string"
    },
    "mixture_manifest_sha256": {
      "const": "2467b5dce0d909b865b73219d2f608bdbc9c6fcc1bb09b93c5ebea8a7b60bd0e",
      "title": "Mixture Manifest Sha256",
      "type": "string"
    },
    "mixture_version": {
      "const": "m5-format-repair-mixture-v1-1396b60b",

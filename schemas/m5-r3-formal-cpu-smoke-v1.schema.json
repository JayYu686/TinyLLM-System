      "title": "Config Sha256",
      "type": "string"
    },
    "contamination": {
      "$ref": "#/$defs/M5R3FormalContaminationReport"
    },
    "evidence_kind": {
      "const": "synthetic_cpu_contract_smoke",
      "title": "Evidence Kind",
      "type": "string"
    },
    "expansion_version": {
      "const": "m5-r3-formal-source-v1",
      "title": "Expansion Version",
      "type": "string"
    },
    "gpu_expansion_authorized": {
      "const": true,
      "title": "Gpu Expansion Authorized",
      "type": "boolean"
    },
    "input_tasks": {
      "const": 240,
      "title": "Input Tasks",
      "type": "integer"
    },
    "model_generated": {
      "const": false,
      "title": "Model Generated",
      "type": "boolean"
    },
    "quality_metric": {
      "const": false,
      "title": "Quality Metric",
      "type": "boolean"
    },
    "r3_mixture_authorized": {
      "const": false,
      "title": "R3 Mixture Authorized",
      "type": "boolean"
    },
    "r3_training_authorized": {
      "const": false,
      "title": "R3 Training Authorized",
      "type": "boolean"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "selected_samples": {
      "const": 160,
      "title": "Selected Samples",
      "type": "integer"
    },
    "stratum_results": {
      "maxItems": 4,
      "minItems": 4,
      "prefixItems": [
        {
          "$ref": "#/$defs/M5R3FormalStratumResult"
        },
        {
          "$ref": "#/$defs/M5R3FormalStratumResult"
        },
        {
          "$ref": "#/$defs/M5R3FormalStratumResult"
        },
        {
          "$ref": "#/$defs/M5R3FormalStratumResult"
        }
      ],
      "title": "Stratum Results",
      "type": "array"
    },
    "task_set_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Task Set Sha256",
      "type": "string"
    },
    "tested_failure_paths": {
      "items": {
        "type": "string"
      },
      "minItems": 3,
      "title": "Tested Failure Paths",
      "type": "array"
    }

  "required": [
    "schema_version",
    "evidence_kind",
    "model_generated",
    "quality_metric",
    "expansion_version",
    "config_sha256",
    "task_set_sha256",
    "input_tasks",
    "accepted_samples",
    "selected_samples",
    "stratum_results",
    "contamination",
    "tested_failure_paths",
    "gpu_expansion_authorized",
    "r3_mixture_authorized",
    "r3_training_authorized"
  ],
  "title": "M5R3FormalCPUSmoke",
  "type": "object"
}

    "git_dirty",
    "solver",
    "compressor",
    "tokenizer_revision",
    "physical_gpu_indices",
    "gpu_names",
    "torch_version",
    "transformers_version",
    "policy_tokenizers_version",
    "shard_count",
    "shard_artifact_sha256s",
    "input_tasks",
    "solver_attempts",
    "compressor_attempts",
    "accepted_samples",
    "rejected_tasks",
    "selected_samples",
    "stratum_results",
    "rejection_counts",
    "contamination",
    "task_set_sha256",
    "accepted_samples_sha256",
    "selected_samples_sha256",
    "duration_seconds",
    "peak_allocated_bytes",
    "peak_reserved_bytes",
    "raw_artifact_sha256",
    "selected_artifact_sha256",
    "formal_source_expansion_complete",
    "r3_mixture_authorized",
    "r3_training_authorized"

      "type": "string"
    },
    "peak_allocated_bytes": {
      "exclusiveMinimum": 0,
      "title": "Peak Allocated Bytes",
      "type": "integer"
    },
    "peak_reserved_bytes": {
      "exclusiveMinimum": 0,
      "title": "Peak Reserved Bytes",
      "type": "integer"
    },
    "physical_gpu_indices": {
      "items": {
        "type": "integer"
      },
      "maxItems": 8,
      "minItems": 1,
      "title": "Physical Gpu Indices",
      "type": "array"
    },
    "policy_tokenizers_version": {
      "const": "0.21.4",
      "title": "Policy Tokenizers Version",
      "type": "string"
    },
    "r3_mixture_authorized": {
      "title": "R3 Mixture Authorized",
      "type": "boolean"
    },
    "r3_training_authorized": {
      "const": false,
      "title": "R3 Training Authorized",
      "type": "boolean"
    },
    "raw_artifact_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Raw Artifact Sha256",
      "type": "string"
    },
    "rejected_tasks": {
      "maximum": 240,
      "minimum": 0,
      "title": "Rejected Tasks",
      "type": "integer"
    },
    "rejection_counts": {
      "additionalProperties": {
        "type": "integer"
      },
      "propertyNames": {
        "enum": [
          "compressor_answer_mismatch",
          "compressor_empty_reasoning",
          "compressor_invalid_json",
          "compressor_length_limit",
          "compressor_runtime_error",
          "duplicate_normalized_trace",
          "identical_line_repetition",
          "missing_evidence_anchor",
          "other_label_mentioned",
          "reasoning_over_192_tokens",
          "repeated_8gram_over_500bp",
          "sequence_over_1024_tokens",
          "solver_answer_mismatch",
          "solver_invalid_output",
          "solver_length_limit",
          "solver_runtime_error"
        ]
      },
      "title": "Rejection Counts",
      "type": "object"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "selected_artifact_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Selected Artifact Sha256",
      "type": "string"
    },
    "selected_samples": {
      "maximum": 160,
      "minimum": 0,
      "title": "Selected Samples",
      "type": "integer"
    },
    "selected_samples_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Selected Samples Sha256",
      "type": "string"
    },
    "shard_artifact_sha256s": {
      "items": {
        "type": "string"
      },
      "maxItems": 8,
      "minItems": 1,
      "title": "Shard Artifact Sha256S",
      "type": "array"
    },
    "shard_count": {
      "maximum": 8,
      "minimum": 1,
      "title": "Shard Count",
      "type": "integer"
    },
    "solver": {
      "$ref": "#/$defs/M5R3FormalSolver"
    },
    "solver_attempts": {
      "const": 240,
      "title": "Solver Attempts",
      "type": "integer"
    },
    "status": {
      "enum": [
        "pass",
        "fail"
      ],
      "title": "Status",
      "type": "string"
    },
    "stratum_results": {
      "maxItems": 4,
      "minItems": 4,
      "prefixItems": [
        {
          "$ref": "#/$defs/M5R3FormalStratumResult"
        },
        {
          "$ref": "#/$defs/M5R3FormalStratumResult"
        },
        {
          "$ref": "#/$defs/M5R3FormalStratumResult"
        },
        {
          "$ref": "#/$defs/M5R3FormalStratumResult"
        }
      ],
      "title": "Stratum Results",
      "type": "array"
    },
    "task_set_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Task Set Sha256",
      "type": "string"
    },
    "tokenizer_revision": {
      "const": "c1899de289a04d12100db370d81485cdf75e47ca",
      "title": "Tokenizer Revision",
      "type": "string"
    },
    "torch_version": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Torch Version",
      "type": "string"
    },
    "transformers_version": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Transformers Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "status",
    "expansion_version",
    "generated_at",
    "config_sha256",
    "parent_content_review_sha256",

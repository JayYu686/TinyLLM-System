        "raw_artifact_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Raw Artifact Sha256",
          "type": "string"
        },
        "result_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Result Sha256",
          "type": "string"
        }
      },
      "required": [
        "result_sha256",
        "raw_artifact_sha256",
        "accepted_samples_sha256"
      ],
      "title": "M5R3FormalSourceLineage",
      "type": "object"
    },
    "M5R3MixtureSelectionPolicy": {
      "additionalProperties": false,

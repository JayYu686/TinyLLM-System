          "type": "integer"
        },
        "policy_id": {
          "const": "family-language-label-balanced-v2",
          "title": "Policy Id",
          "type": "string"
        },
        "quotas": {
          "additionalProperties": {
            "additionalProperties": {
              "additionalProperties": {
                "type": "integer"
              },
              "type": "object"
            },
            "propertyNames": {
              "enum": [
                "en",
                "zh"
              ]
            },
            "type": "object"
          },
          "propertyNames": {
            "enum": [
              "config",
              "log_diagnosis"
            ]
          },
          "title": "Quotas",
          "type": "object"
        },
        "stable_sort": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "const": "reasoning_tokens",
              "type": "string"
            },
            {
              "const": "repeated_8gram_basis_points",
              "type": "string"
            },
            {
              "const": "sample_id",
              "type": "string"
            }
          ],
          "title": "Stable Sort",
          "type": "array"

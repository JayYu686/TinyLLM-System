{
  "$defs": {
    "M5MixtureArtifactFile": {
      "additionalProperties": false,
      "description": "One immutable private mixture payload.",
      "properties": {
        "path": {
          "const": "sequences.npz",
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "exclusiveMinimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "size_bytes",
        "sha256"
      ],
      "title": "M5MixtureArtifactFile",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Content-addressed R3 mixture with exact strata and source-use evidence.",
  "properties": {
    "artifact": {
      "$ref": "#/$defs/M5MixtureArtifactFile"
    },
    "build_seed": {
      "const": 20260731,
      "title": "Build Seed",
      "type": "integer"
    },
    "config_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Config Sha256",
      "type": "string"
    },
    "consume_m6_frozen_results": {
      "const": false,
      "title": "Consume M6 Frozen Results",
      "type": "boolean"
    },
    "content_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Content Sha256",
      "type": "string"
    },
    "dataset_name": {
      "const": "m5-r3-mixture",
      "default": "m5-r3-mixture",
      "title": "Dataset Name",
      "type": "string"
    },
    "formal_accepted_samples_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Formal Accepted Samples Sha256",
      "type": "string"
    },
    "formal_raw_artifact_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Formal Raw Artifact Sha256",
      "type": "string"
    },
    "formal_result_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Formal Result Sha256",
      "type": "string"
    },
    "general_thinking_reuse_count": {
      "minimum": 0,
      "title": "General Thinking Reuse Count",
      "type": "integer"
    },
    "general_thinking_sequence_count": {
      "exclusiveMinimum": 0,
      "title": "General Thinking Sequence Count",
      "type": "integer"
    },
    "general_thinking_source_sequences": {
      "const": 96,
      "title": "General Thinking Source Sequences",
      "type": "integer"
    },
    "general_thinking_supervised_tokens": {
      "const": 150000,
      "title": "General Thinking Supervised Tokens",
      "type": "integer"
    },
    "mixture_version": {
      "pattern": "^m5-r3-mixture-v2-[0-9a-f]{8}$",
      "title": "Mixture Version",
      "type": "string"
    },
    "nonthinking_reuse_count": {
      "minimum": 0,
      "title": "Nonthinking Reuse Count",
      "type": "integer"
    },
    "nonthinking_sequence_count": {
      "exclusiveMinimum": 0,
      "title": "Nonthinking Sequence Count",
      "type": "integer"
    },
    "nonthinking_source_sequences": {
      "exclusiveMinimum": 0,
      "title": "Nonthinking Source Sequences",
      "type": "integer"
    },
    "nonthinking_supervised_tokens": {
      "const": 700000,
      "title": "Nonthinking Supervised Tokens",
      "type": "integer"
    },
    "nonthinking_template_id": {
      "const": "qwen3-chatml-nonthinking-v1",
      "title": "Nonthinking Template Id",
      "type": "string"
    },
    "pad_token_id": {
      "const": 151643,
      "title": "Pad Token Id",
      "type": "integer"
    },
    "parent_content_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Parent Content Sha256",
      "type": "string"
    },
    "parent_dataset_version": {
      "const": "m2-sft-v1-f82ff32e",
      "title": "Parent Dataset Version",
      "type": "string"
    },
    "partially_masked_sequences": {
      "maximum": 3,
      "minimum": 0,
      "title": "Partially Masked Sequences",
      "type": "integer"
    },
    "pilot_content_sha256": {
      "const": "b4db5ac8c9252b701c573de56a1f91629e3b1716e23223e5b2b979c5cc285684",
      "title": "Pilot Content Sha256",
      "type": "string"
    },
    "pilot_dataset_version": {
      "const": "m5-reasoning-pilot-v1-b4db5ac8",
      "title": "Pilot Dataset Version",
      "type": "string"
    },
    "r3_training_authorized": {
      "const": true,
      "title": "R3 Training Authorized",
      "type": "boolean"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "sequence_count": {
      "exclusiveMinimum": 0,
      "title": "Sequence Count",
      "type": "integer"
    },
    "sequence_length": {
      "const": 1024,
      "title": "Sequence Length",
      "type": "integer"
    },
    "target_supervised_tokens": {
      "const": 1000000,
      "title": "Target Supervised Tokens",
      "type": "integer"
    },
    "targeted_selection_policy_id": {
      "const": "family-language-label-balanced-v2",
      "title": "Targeted Selection Policy Id",
      "type": "string"
    },
    "targeted_selection_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Targeted Selection Sha256",
      "type": "string"
    },
    "targeted_source_family_counts": {
      "additionalProperties": {
        "type": "integer"
      },
      "propertyNames": {
        "enum": [
          "config",
          "log_diagnosis"
        ]
      },
      "title": "Targeted Source Family Counts",
      "type": "object"
    },
    "targeted_source_label_counts": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Targeted Source Label Counts",
      "type": "object"
    },
    "targeted_source_language_counts": {
      "additionalProperties": {
        "type": "integer"
      },
      "propertyNames": {
        "enum": [
          "en",
          "zh"
        ]
      },
      "title": "Targeted Source Language Counts",
      "type": "object"
    },
    "targeted_source_supervised_tokens_per_pass": {
      "exclusiveMinimum": 0,
      "title": "Targeted Source Supervised Tokens Per Pass",
      "type": "integer"
    },
    "targeted_source_use_max": {
      "exclusiveMinimum": 0,
      "maximum": 30,
      "title": "Targeted Source Use Max",
      "type": "integer"
    },
    "targeted_source_use_min": {
      "exclusiveMinimum": 0,
      "maximum": 30,
      "title": "Targeted Source Use Min",
      "type": "integer"
    },
    "targeted_thinking_reuse_count": {
      "minimum": 0,
      "title": "Targeted Thinking Reuse Count",
      "type": "integer"
    },
    "targeted_thinking_sequence_count": {
      "exclusiveMinimum": 0,
      "title": "Targeted Thinking Sequence Count",
      "type": "integer"
    },
    "targeted_thinking_source_sequences": {
      "const": 160,
      "title": "Targeted Thinking Source Sequences",
      "type": "integer"
    },
    "targeted_thinking_supervised_tokens": {
      "const": 150000,
      "title": "Targeted Thinking Supervised Tokens",
      "type": "integer"
    },
    "thinking_fraction_basis_points": {
      "const": 3000,
      "title": "Thinking Fraction Basis Points",
      "type": "integer"
    },
    "thinking_supervised_tokens": {
      "const": 300000,
      "title": "Thinking Supervised Tokens",
      "type": "integer"
    },
    "thinking_template_id": {
      "const": "qwen3-chatml-thinking-v1",
      "title": "Thinking Template Id",
      "type": "string"
    },
    "tokenizer_revision": {
      "const": "c1899de289a04d12100db370d81485cdf75e47ca",
      "title": "Tokenizer Revision",
      "type": "string"
    }
  },
  "required": [
    "mixture_version",
    "config_sha256",
    "parent_dataset_version",
    "parent_content_sha256",
    "pilot_dataset_version",
    "pilot_content_sha256",
    "formal_result_sha256",
    "formal_raw_artifact_sha256",
    "formal_accepted_samples_sha256",
    "targeted_selection_policy_id",
    "targeted_selection_sha256",
    "tokenizer_revision",
    "nonthinking_template_id",
    "thinking_template_id",
    "sequence_length",
    "pad_token_id",
    "target_supervised_tokens",
    "thinking_fraction_basis_points",
    "nonthinking_supervised_tokens",
    "thinking_supervised_tokens",
    "general_thinking_supervised_tokens",
    "targeted_thinking_supervised_tokens",
    "sequence_count",
    "nonthinking_sequence_count",
    "general_thinking_sequence_count",
    "targeted_thinking_sequence_count",
    "nonthinking_source_sequences",
    "general_thinking_source_sequences",
    "targeted_thinking_source_sequences",
    "nonthinking_reuse_count",
    "general_thinking_reuse_count",
    "targeted_thinking_reuse_count",
    "targeted_source_supervised_tokens_per_pass",
    "targeted_source_use_min",
    "targeted_source_use_max",
    "partially_masked_sequences",
    "targeted_source_family_counts",
    "targeted_source_language_counts",
    "targeted_source_label_counts",
    "build_seed",
    "content_sha256",
    "artifact",
    "r3_training_authorized",
    "consume_m6_frozen_results"
  ],
  "title": "M5R3MixtureManifest",
  "type": "object"
}

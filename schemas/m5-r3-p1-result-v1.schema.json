{
  "$defs": {
    "M5R3P1CompressorStage": {
      "additionalProperties": false,
      "description": "Greedy Non-thinking stage producing a constrained rationale envelope.",
      "properties": {
        "attention_architecture": {
          "const": "gqa",
          "title": "Attention Architecture",
          "type": "string"
        },
        "base_seed": {
          "const": 20260805,
          "title": "Base Seed",
          "type": "integer"
        },
        "candidate_count": {
          "const": 1,
          "title": "Candidate Count",
          "type": "integer"
        },
        "do_sample": {
          "const": false,
          "title": "Do Sample",
          "type": "boolean"
        },
        "dtype": {
          "const": "bfloat16",
          "title": "Dtype",
          "type": "string"
        },
        "local_files_only": {
          "const": true,
          "title": "Local Files Only",
          "type": "boolean"
        },
        "max_new_tokens": {
          "const": 256,
          "title": "Max New Tokens",
          "type": "integer"
        },
        "mode": {
          "const": "nonthinking",
          "title": "Mode",
          "type": "string"
        },
        "output_protocol": {
          "const": "m5-r3-compressed-rationale-json-v1",
          "title": "Output Protocol",
          "type": "string"
        },
        "repository": {
          "const": "Qwen/Qwen3-8B",
          "title": "Repository",
          "type": "string"
        },
        "revision": {
          "const": "b968826d9c46dd6066d109eabc6255188de91218",
          "title": "Revision",
          "type": "string"
        },
        "trust_remote_code": {
          "const": false,
          "title": "Trust Remote Code",
          "type": "boolean"
        }
      },
      "required": [
        "repository",
        "revision",
        "attention_architecture",
        "trust_remote_code",
        "local_files_only",
        "dtype",
        "mode",
        "do_sample",
        "candidate_count",
        "max_new_tokens",
        "base_seed",
        "output_protocol"
      ],
      "title": "M5R3P1CompressorStage",
      "type": "object"
    },
    "M5R3P1ContaminationReport": {
      "additionalProperties": false,
      "description": "Path-free P1 collision counts against all frozen prior task sets.",
      "properties": {
        "algorithm": {
          "const": "m5-r3-p1-exact-normalized-template-v1",
          "title": "Algorithm",
          "type": "string"
        },
        "dev_exact_prompt_matches": {
          "minimum": 0,
          "title": "Dev Exact Prompt Matches",
          "type": "integer"
        },
        "dev_task_count": {
          "const": 200,
          "title": "Dev Task Count",
          "type": "integer"
        },
        "dev_template_family_overlaps": {
          "minimum": 0,
          "title": "Dev Template Family Overlaps",
          "type": "integer"
        },
        "historical_exact_prompt_matches": {
          "minimum": 0,
          "title": "Historical Exact Prompt Matches",
          "type": "integer"
        },
        "historical_normalized_prompt_matches": {
          "minimum": 0,
          "title": "Historical Normalized Prompt Matches",
          "type": "integer"
        },
        "historical_pilot_task_count": {
          "const": 100,
          "title": "Historical Pilot Task Count",
          "type": "integer"
        },
        "historical_template_family_overlaps": {
          "minimum": 0,
          "title": "Historical Template Family Overlaps",
          "type": "integer"
        },
        "p0_exact_prompt_matches": {
          "minimum": 0,
          "title": "P0 Exact Prompt Matches",
          "type": "integer"
        },
        "p0_normalized_prompt_matches": {
          "minimum": 0,
          "title": "P0 Normalized Prompt Matches",
          "type": "integer"
        },
        "p0_r1_exact_prompt_matches": {
          "minimum": 0,
          "title": "P0 R1 Exact Prompt Matches",
          "type": "integer"
        },
        "p0_r1_normalized_prompt_matches": {
          "minimum": 0,
          "title": "P0 R1 Normalized Prompt Matches",
          "type": "integer"
        },
        "p0_r1_template_family_overlaps": {
          "minimum": 0,
          "title": "P0 R1 Template Family Overlaps",
          "type": "integer"
        },
        "p0_template_family_overlaps": {
          "minimum": 0,
          "title": "P0 Template Family Overlaps",
          "type": "integer"
        },
        "p1_task_count": {
          "const": 40,
          "title": "P1 Task Count",
          "type": "integer"
        },
        "parent_p0_r1_task_count": {
          "const": 40,
          "title": "Parent P0 R1 Task Count",
          "type": "integer"
        },
        "parent_p0_task_count": {
          "const": 40,
          "title": "Parent P0 Task Count",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "enum": [
            "pass",
            "fail"
          ],
          "title": "Status",
          "type": "string"
        },
        "task_set_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Task Set Sha256",
          "type": "string"
        }
      },
      "required": [
        "algorithm",
        "task_set_sha256",
        "p1_task_count",
        "dev_task_count",
        "historical_pilot_task_count",
        "parent_p0_task_count",
        "parent_p0_r1_task_count",
        "dev_exact_prompt_matches",
        "dev_template_family_overlaps",
        "historical_exact_prompt_matches",
        "historical_normalized_prompt_matches",
        "historical_template_family_overlaps",
        "p0_exact_prompt_matches",
        "p0_normalized_prompt_matches",
        "p0_template_family_overlaps",
        "p0_r1_exact_prompt_matches",
        "p0_r1_normalized_prompt_matches",
        "p0_r1_template_family_overlaps",
        "status"
      ],
      "title": "M5R3P1ContaminationReport",
      "type": "object"
    },
    "M5R3P1ControlResult": {
      "additionalProperties": false,
      "description": "Structural result for deterministic rule traces.",
      "properties": {
        "input_tasks": {
          "const": 40,
          "title": "Input Tasks",
          "type": "integer"
        },
        "reasoning_tokens_max": {
          "exclusiveMinimum": 0,
          "maximum": 192,
          "title": "Reasoning Tokens Max",
          "type": "integer"
        },
        "source_kind": {
          "const": "deterministic_rule_trace",
          "title": "Source Kind",
          "type": "string"
        },
        "status": {
          "enum": [
            "pass",
            "fail"
          ],
          "title": "Status",
          "type": "string"
        },
        "structural_passes": {
          "maximum": 40,
          "minimum": 0,
          "title": "Structural Passes",
          "type": "integer"
        },
        "training_source_authorized": {
          "const": false,
          "title": "Training Source Authorized",
          "type": "boolean"
        },
        "unique_trace_count": {
          "maximum": 40,
          "minimum": 0,
          "title": "Unique Trace Count",
          "type": "integer"
        }
      },
      "required": [
        "source_kind",
        "input_tasks",
        "structural_passes",
        "reasoning_tokens_max",
        "unique_trace_count",
        "status",
        "training_source_authorized"
      ],
      "title": "M5R3P1ControlResult",
      "type": "object"
    },
    "M5R3P1FamilyResult": {
      "additionalProperties": false,
      "description": "Public accepted distribution for one P1 family.",
      "properties": {
        "accepted_items": {
          "maximum": 20,
          "minimum": 0,
          "title": "Accepted Items",
          "type": "integer"
        },
        "accepted_language_counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "propertyNames": {
            "enum": [
              "en",
              "zh"
            ]
          },
          "title": "Accepted Language Counts",
          "type": "object"
        },
        "gate_passed": {
          "title": "Gate Passed",
          "type": "boolean"
        },
        "input_language_counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "propertyNames": {
            "enum": [
              "en",
              "zh"
            ]
          },
          "title": "Input Language Counts",
          "type": "object"
        },
        "input_tasks": {
          "const": 20,
          "title": "Input Tasks",
          "type": "integer"
        },
        "reasoning_tokens_max": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 192,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reasoning Tokens Max"
        },
        "reasoning_tokens_min": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 192,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reasoning Tokens Min"
        },
        "reasoning_tokens_p50": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 192,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reasoning Tokens P50"
        },
        "reasoning_tokens_p90": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 192,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reasoning Tokens P90"
        },
        "task_family": {
          "enum": [
            "config",
            "log_diagnosis"
          ],
          "title": "Task Family",
          "type": "string"
        }
      },
      "required": [
        "task_family",
        "input_tasks",
        "input_language_counts",
        "accepted_items",
        "accepted_language_counts",
        "gate_passed"
      ],
      "title": "M5R3P1FamilyResult",
      "type": "object"
    },
    "M5R3P1SolverStage": {
      "additionalProperties": false,
      "description": "Native-Thinking correctness stage used before compression.",
      "properties": {
        "attention_architecture": {
          "const": "gqa",
          "title": "Attention Architecture",
          "type": "string"
        },
        "base_seed": {
          "const": 20260804,
          "title": "Base Seed",
          "type": "integer"
        },
        "candidate_count": {
          "const": 1,
          "title": "Candidate Count",
          "type": "integer"
        },
        "do_sample": {
          "const": true,
          "title": "Do Sample",
          "type": "boolean"
        },
        "dtype": {
          "const": "bfloat16",
          "title": "Dtype",
          "type": "string"
        },
        "local_files_only": {
          "const": true,
          "title": "Local Files Only",
          "type": "boolean"
        },
        "max_new_tokens": {
          "const": 896,
          "title": "Max New Tokens",
          "type": "integer"
        },
        "mode": {
          "const": "thinking",
          "title": "Mode",
          "type": "string"
        },
        "repetition_penalty": {
          "title": "Repetition Penalty",
          "type": "number"
        },
        "repository": {
          "const": "Qwen/Qwen3-8B",
          "title": "Repository",
          "type": "string"
        },
        "revision": {
          "const": "b968826d9c46dd6066d109eabc6255188de91218",
          "title": "Revision",
          "type": "string"
        },
        "temperature": {
          "title": "Temperature",
          "type": "number"
        },
        "top_k": {
          "const": 20,
          "title": "Top K",
          "type": "integer"
        },
        "top_p": {
          "title": "Top P",
          "type": "number"
        },
        "trust_remote_code": {
          "const": false,
          "title": "Trust Remote Code",
          "type": "boolean"
        }
      },
      "required": [
        "repository",
        "revision",
        "attention_architecture",
        "trust_remote_code",
        "local_files_only",
        "dtype",
        "mode",
        "do_sample",
        "temperature",
        "top_p",
        "top_k",
        "repetition_penalty",
        "candidate_count",
        "max_new_tokens",
        "base_seed"
      ],
      "title": "M5R3P1SolverStage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Public path-free result of one real two-stage P1 GPU Pilot.",
  "properties": {
    "accepted_samples": {
      "maximum": 40,
      "minimum": 0,
      "title": "Accepted Samples",
      "type": "integer"
    },
    "compressor": {
      "$ref": "#/$defs/M5R3P1CompressorStage"
    },
    "compressor_attempts": {
      "maximum": 40,
      "minimum": 0,
      "title": "Compressor Attempts",
      "type": "integer"
    },
    "config_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Config Sha256",
      "type": "string"
    },
    "consumes_m6_frozen_results": {
      "const": false,
      "default": false,
      "title": "Consumes M6 Frozen Results",
      "type": "boolean"
    },
    "contamination": {
      "$ref": "#/$defs/M5R3P1ContaminationReport"
    },
    "control": {
      "$ref": "#/$defs/M5R3P1ControlResult"
    },
    "duration_seconds": {
      "exclusiveMinimum": 0,
      "title": "Duration Seconds",
      "type": "number"
    },
    "family_results": {
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "$ref": "#/$defs/M5R3P1FamilyResult"
        },
        {
          "$ref": "#/$defs/M5R3P1FamilyResult"
        }
      ],
      "title": "Family Results",
      "type": "array"
    },
    "formal_source_expansion_authorized": {
      "title": "Formal Source Expansion Authorized",
      "type": "boolean"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "git_commit": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Git Commit",
      "type": "string"
    },
    "git_dirty": {
      "title": "Git Dirty",
      "type": "boolean"
    },
    "gpu_name": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Gpu Name",
      "type": "string"
    },
    "input_tasks": {
      "const": 40,
      "title": "Input Tasks",
      "type": "integer"
    },
    "peak_allocated_bytes": {
      "exclusiveMinimum": 0,
      "title": "Peak Allocated Bytes",
      "type": "integer"
    },
    "peak_reserved_bytes": {
      "exclusiveMinimum": 0,
      "title": "Peak Reserved Bytes",
      "type": "integer"
    },
    "physical_gpu_index": {
      "minimum": 0,
      "title": "Physical Gpu Index",
      "type": "integer"
    },
    "pilot_version": {
      "const": "m5-r3-p1-two-stage-v1",
      "title": "Pilot Version",
      "type": "string"
    },
    "policy_tokenizers_version": {
      "const": "0.21.4",
      "title": "Policy Tokenizers Version",
      "type": "string"
    },
    "r3_mixture_authorized": {
      "const": false,
      "default": false,
      "title": "R3 Mixture Authorized",
      "type": "boolean"
    },
    "r3_training_authorized": {
      "const": false,
      "default": false,
      "title": "R3 Training Authorized",
      "type": "boolean"
    },
    "raw_artifact_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Raw Artifact Sha256",
      "type": "string"
    },
    "rejected_tasks": {
      "maximum": 40,
      "minimum": 0,
      "title": "Rejected Tasks",
      "type": "integer"
    },
    "rejection_counts": {
      "additionalProperties": {
        "type": "integer"
      },
      "propertyNames": {
        "enum": [
          "compressor_answer_mismatch",
          "compressor_empty_reasoning",
          "compressor_invalid_json",
          "compressor_length_limit",
          "compressor_runtime_error",
          "duplicate_normalized_trace",
          "identical_line_repetition",
          "missing_evidence_anchor",
          "other_label_mentioned",
          "reasoning_over_192_tokens",
          "repeated_8gram_over_500bp",
          "sequence_over_1024_tokens",
          "solver_answer_mismatch",
          "solver_invalid_output",
          "solver_length_limit",
          "solver_runtime_error"
        ]
      },
      "title": "Rejection Counts",
      "type": "object"
    },
    "samples_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Samples Sha256",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "solver": {
      "$ref": "#/$defs/M5R3P1SolverStage"
    },
    "solver_attempts": {
      "maximum": 40,
      "minimum": 1,
      "title": "Solver Attempts",
      "type": "integer"
    },
    "status": {
      "enum": [
        "pass",
        "fail"
      ],
      "title": "Status",
      "type": "string"
    },
    "task_set_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Task Set Sha256",
      "type": "string"
    },
    "teacher_tokenizers_version": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Teacher Tokenizers Version",
      "type": "string"
    },
    "tokenizer_revision": {
      "const": "c1899de289a04d12100db370d81485cdf75e47ca",
      "title": "Tokenizer Revision",
      "type": "string"
    },
    "torch_version": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Torch Version",
      "type": "string"
    },
    "transformers_version": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Transformers Version",
      "type": "string"
    }
  },
  "required": [
    "status",
    "pilot_version",
    "generated_at",
    "config_sha256",
    "git_commit",
    "git_dirty",
    "solver",
    "compressor",
    "tokenizer_revision",
    "physical_gpu_index",
    "gpu_name",
    "torch_version",
    "transformers_version",
    "teacher_tokenizers_version",
    "policy_tokenizers_version",
    "input_tasks",
    "solver_attempts",
    "compressor_attempts",
    "accepted_samples",
    "rejected_tasks",
    "family_results",
    "rejection_counts",
    "control",
    "contamination",
    "task_set_sha256",
    "samples_sha256",
    "duration_seconds",
    "peak_allocated_bytes",
    "peak_reserved_bytes",
    "raw_artifact_sha256",
    "formal_source_expansion_authorized"
  ],
  "title": "M5R3P1Result",
  "type": "object"
}

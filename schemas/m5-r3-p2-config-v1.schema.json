        "reject_other_labels": {
          "const": true,
          "title": "Reject Other Labels",
          "type": "boolean"
        },
        "require_exact_evidence_anchor": {
          "const": true,
          "title": "Require Exact Evidence Anchor",
          "type": "boolean"

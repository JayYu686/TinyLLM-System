            "propertyNames": {
              "enum": [
                "en",
                "zh"
              ]
            },
            "type": "object"
          },
          "propertyNames": {
            "enum": [
              "config",
              "log_diagnosis"
            ]
          },
          "title": "Accepted Languages Per Family",
          "type": "object"
        },
        "accepted_per_family": {
          "additionalProperties": {
            "const": 14,
            "type": "integer"
          },
          "propertyNames": {
            "enum": [
              "config",
              "log_diagnosis"
            ]
          },
          "title": "Accepted Per Family",
          "type": "object"
        }
      },
      "required": [
        "accepted_per_family",
        "accepted_languages_per_family"

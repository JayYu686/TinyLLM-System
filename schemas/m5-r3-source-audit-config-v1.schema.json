{
  "$defs": {
    "M5R3SourceRequirement": {
      "additionalProperties": false,
      "description": "Minimum distinct source examples required before building the R3 mixture.",
      "properties": {
        "max_training_passes_per_source": {
          "const": 4,
          "title": "Max Training Passes Per Source",
          "type": "integer"
        },
        "selected_languages_per_family": {
          "additionalProperties": {
            "additionalProperties": {
              "type": "integer"
            },
            "propertyNames": {
              "enum": [
                "en",
                "zh"
              ]
            },
            "type": "object"
          },
          "propertyNames": {
            "enum": [
              "config",
              "log_diagnosis"
            ]
          },
          "title": "Selected Languages Per Family",
          "type": "object"
        },
        "selected_per_family": {
          "additionalProperties": {
            "const": 80,
            "type": "integer"
          },
          "propertyNames": {
            "enum": [
              "config",
              "log_diagnosis"
            ]
          },
          "title": "Selected Per Family",
          "type": "object"
        }
      },
      "required": [
        "selected_per_family",
        "selected_languages_per_family",
        "max_training_passes_per_source"
      ],
      "title": "M5R3SourceRequirement",
      "type": "object"
    },
    "M5R3TracePolicy": {
      "additionalProperties": false,
      "description": "Content and diversity constraints for one accepted targeted trace.",
      "properties": {
        "max_identical_line_hash_repetitions": {
          "const": 1,
          "title": "Max Identical Line Hash Repetitions",
          "type": "integer"
        },
        "max_reasoning_tokens": {
          "const": 192,
          "title": "Max Reasoning Tokens",
          "type": "integer"
        },
        "max_repeated_8gram_basis_points": {
          "const": 500,
          "title": "Max Repeated 8Gram Basis Points",
          "type": "integer"
        },
        "require_unique_normalized_trace": {
          "const": true,
          "title": "Require Unique Normalized Trace",
          "type": "boolean"
        }
      },
      "required": [
        "max_reasoning_tokens",
        "max_repeated_8gram_basis_points",
        "max_identical_line_hash_repetitions",
        "require_unique_normalized_trace"
      ],
      "title": "M5R3TracePolicy",
      "type": "object"
    }
  },

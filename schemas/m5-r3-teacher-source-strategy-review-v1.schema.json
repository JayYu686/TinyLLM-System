{
  "$defs": {
    "M5R3StrategyAlternative": {
      "additionalProperties": false,
      "description": "One reviewed source strategy and its preregistered disposition.",
      "properties": {
        "disposition": {
          "enum": [
            "selected_for_p1",
            "control_only",
            "rejected"
          ],
          "title": "Disposition",
          "type": "string"
        },
        "evidence_reason": {
          "enum": [
            "p0_and_p0_r1_failed_same_gate",
            "r2_1536_projection_failed_99_percent",
            "separates_correctness_from_length_control",
            "deterministic_control_not_formal_teacher_source"
          ],
          "title": "Evidence Reason",
          "type": "string"
        },
        "strategy": {
          "enum": [
            "single_stage_prompt_control",
            "higher_generation_ceiling_only",
            "two_stage_solve_compress",
            "deterministic_rule_trace"
          ],
          "title": "Strategy",
          "type": "string"
        }
      },
      "required": [
        "strategy",
        "disposition",
        "evidence_reason"
      ],
      "title": "M5R3StrategyAlternative",
      "type": "object"
    },
    "M5R3StrategyObservation": {
      "additionalProperties": false,
      "description": "Content-free facts extracted from one completed parent experiment.",
      "properties": {
        "accepted_languages": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "integer"
              },
              "propertyNames": {
                "enum": [
                  "en",
                  "zh"
                ]
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Accepted Languages"
        },
        "accepted_per_family": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "integer"
                },
                {
                  "type": "integer"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Accepted Per Family"
        },
        "accepted_samples": {
          "anyOf": [
            {
              "maximum": 40,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Accepted Samples"
        },
        "experiment": {
          "enum": [
            "r2",
            "p0",
            "p0_r1"
          ],
          "title": "Experiment",
          "type": "string"
        },
        "projected_format_basis_points": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "integer"
                },
                {
                  "type": "integer"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Projected Format Basis Points"
        },
        "reasoning_over_192_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reasoning Over 192 Tokens"
        },
        "status": {
          "enum": [
            "length_ceiling_insufficient",
            "fail"
          ],
          "title": "Status",
          "type": "string"
        },
        "teacher_length_limit": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Teacher Length Limit"
        },
        "unresolved_format_items": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "integer"
                },
                {
                  "type": "integer"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unresolved Format Items"
        }
      },
      "required": [
        "experiment",
        "status"
      ],
      "title": "M5R3StrategyObservation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Path-free decision derived only from committed real evidence.",
  "properties": {
    "alternatives": {
      "maxItems": 4,
      "minItems": 4,
      "prefixItems": [
        {
          "$ref": "#/$defs/M5R3StrategyAlternative"
        },
        {
          "$ref": "#/$defs/M5R3StrategyAlternative"
        },
        {
          "$ref": "#/$defs/M5R3StrategyAlternative"
        },
        {
          "$ref": "#/$defs/M5R3StrategyAlternative"
        }
      ],
      "title": "Alternatives",
      "type": "array"
    },
    "consumes_m6_frozen_results": {
      "const": false,
      "default": false,
      "title": "Consumes M6 Frozen Results",
      "type": "boolean"
    },
    "controlled_baseline": {
      "const": "deterministic_rule_trace",
      "title": "Controlled Baseline",
      "type": "string"
    },
    "decision_reason": {
      "const": "single_stage_length_control_failed_select_two_stage_with_rule_control",
      "title": "Decision Reason",
      "type": "string"
    },
    "evidence_kind": {
      "const": "deterministic_review_of_real_public_results",
      "title": "Evidence Kind",
      "type": "string"
    },
    "formal_source_expansion_authorized": {
      "const": false,
      "title": "Formal Source Expansion Authorized",
      "type": "boolean"
    },
    "next_pilot_version": {
      "const": "m5-r3-p1-two-stage-v1",
      "title": "Next Pilot Version",
      "type": "string"
    },
    "observations": {
      "maxItems": 3,
      "minItems": 3,
      "prefixItems": [
        {
          "$ref": "#/$defs/M5R3StrategyObservation"
        },
        {
          "$ref": "#/$defs/M5R3StrategyObservation"
        },
        {
          "$ref": "#/$defs/M5R3StrategyObservation"
        }
      ],
      "title": "Observations",
      "type": "array"
    },
    "p1_contract_implementation_authorized": {
      "const": true,
      "title": "P1 Contract Implementation Authorized",
      "type": "boolean"
    },
    "p1_gpu_pilot_authorized": {
      "const": false,
      "title": "P1 Gpu Pilot Authorized",
      "type": "boolean"
    },
    "parent_p0_r1_result_sha256": {
      "const": "c59ab59fd048620e2b8de6a985a5a1deb877bb786d9b28b813531437b582c0b7",
      "title": "Parent P0 R1 Result Sha256",
      "type": "string"
    },
    "parent_p0_result_sha256": {
      "const": "5eff250ef4cde98d044c992a0aaf7e2eb75342faa9c377d265a25945a3d4388b",
      "title": "Parent P0 Result Sha256",
      "type": "string"
    },
    "parent_r2_decision_sha256": {
      "const": "04165538efce811240b4d4501b13f74151758af7373704c12d6df882e3044ed6",
      "title": "Parent R2 Decision Sha256",
      "type": "string"
    },
    "quality_metric": {
      "const": false,
      "title": "Quality Metric",
      "type": "boolean"
    },
    "r3_mixture_authorized": {
      "const": false,
      "title": "R3 Mixture Authorized",
      "type": "boolean"
    },
    "r3_training_authorized": {
      "const": false,
      "title": "R3 Training Authorized",
      "type": "boolean"
    },
    "review_config_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Review Config Sha256",
      "type": "string"
    },
    "review_version": {
      "const": "m5-r3-teacher-source-strategy-v1",
      "title": "Review Version",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "selected_strategy": {
      "const": "two_stage_solve_compress",
      "title": "Selected Strategy",
      "type": "string"
    },
    "status": {
      "const": "two_stage_contract_authorized",
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "status",
    "evidence_kind",
    "quality_metric",
    "review_version",
    "review_config_sha256",
    "parent_r2_decision_sha256",
    "parent_p0_result_sha256",
    "parent_p0_r1_result_sha256",
    "observations",
    "alternatives",
    "selected_strategy",
    "controlled_baseline",
    "next_pilot_version",
    "p1_contract_implementation_authorized",
    "p1_gpu_pilot_authorized",
    "formal_source_expansion_authorized",
    "r3_mixture_authorized",
    "r3_training_authorized",
    "decision_reason"
  ],
  "title": "M5R3TeacherSourceStrategyReview",
  "type": "object"
}

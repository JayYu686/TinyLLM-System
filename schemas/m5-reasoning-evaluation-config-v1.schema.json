      "title": "Schema Version",
      "type": "string"
    },
    "suite_version": {
      "const": "m5-reasoning-dev-v1-3eb153c2",
      "title": "Suite Version",
      "type": "string"
    },
    "task_config_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Task Config Sha256",
      "type": "string"

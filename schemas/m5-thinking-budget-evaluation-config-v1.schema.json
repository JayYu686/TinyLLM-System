      "const": 1000,
      "title": "Max Forced Close Basis Points",
      "type": "integer"
    },
    "min_thinking_score_basis_points": {
      "const": 9000,
      "title": "Min Thinking Score Basis Points",
      "type": "integer"
    },
    "model_repository": {

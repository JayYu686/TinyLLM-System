{
  "$defs": {
    "M5ThinkingBudgetGenerationConfig": {
      "additionalProperties": false,
      "description": "Qwen-official two-stage generation policy with a bounded final continuation.",
      "properties": {
        "base_seed": {
          "const": 20260726,
          "title": "Base Seed",
          "type": "integer"
        },
        "batch_size": {
          "const": 4,
          "title": "Batch Size",
          "type": "integer"
        },
        "early_stopping_text": {
          "const": "\n\n Considering the limited time by the user, I have to give the solution based on the thinking directly now.\n</think>\n\n",
          "title": "Early Stopping Text",
          "type": "string"
        },
        "final_answer_max_new_tokens": {
          "const": 128,
          "title": "Final Answer Max New Tokens",
          "type": "integer"
        },
        "nonthinking_do_sample": {
          "const": false,
          "title": "Nonthinking Do Sample",
          "type": "boolean"
        },
        "nonthinking_max_new_tokens": {
          "const": 128,
          "title": "Nonthinking Max New Tokens",
          "type": "integer"
        },
        "repetition_penalty": {
          "maximum": 2.0,
          "minimum": 1.0,
          "title": "Repetition Penalty",
          "type": "number"
        },
        "temperature": {
          "exclusiveMinimum": 0.0,
          "maximum": 2.0,
          "title": "Temperature",
          "type": "number"
        },
        "thinking_budget_tokens": {
          "const": 1536,
          "title": "Thinking Budget Tokens",
          "type": "integer"
        },
        "thinking_do_sample": {
          "const": true,
          "title": "Thinking Do Sample",
          "type": "boolean"
        },
        "top_k": {
          "const": 20,
          "title": "Top K",
          "type": "integer"
        },
        "top_p": {
          "exclusiveMinimum": 0.0,
          "maximum": 1.0,
          "title": "Top P",
          "type": "number"
        }
      },
      "required": [
        "batch_size",
        "thinking_budget_tokens",
        "final_answer_max_new_tokens",
        "nonthinking_max_new_tokens",
        "thinking_do_sample",
        "temperature",
        "top_p",
        "top_k",
        "repetition_penalty",
        "nonthinking_do_sample",
        "base_seed",
        "early_stopping_text"
      ],
      "title": "M5ThinkingBudgetGenerationConfig",
      "type": "object"
    }
  },
  "additionalProperties": false,

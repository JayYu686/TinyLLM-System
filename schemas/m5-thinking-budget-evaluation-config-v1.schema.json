      "type": "string"
    },
    "base_revision": {
      "enum": [
        "c1899de289a04d12100db370d81485cdf75e47ca",
        "b968826d9c46dd6066d109eabc6255188de91218"
      ],
      "title": "Base Revision",
      "type": "string"
    },
    "compare_modes_separately": {
      "const": true,
      "title": "Compare Modes Separately",
      "type": "boolean"
    },
    "consume_m6_frozen_results": {
      "const": false,
      "title": "Consume M6 Frozen Results",
      "type": "boolean"
    },
    "controlled_format_min_basis_points": {
      "const": 9900,
      "title": "Controlled Format Min Basis Points",
      "type": "integer"
    },
    "expected_items": {
      "const": 200,
      "title": "Expected Items",
      "type": "integer"
    },
    "generation": {

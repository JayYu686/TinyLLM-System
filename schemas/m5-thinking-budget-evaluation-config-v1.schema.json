    "suite_version",
    "expected_items",
    "task_config_sha256",
    "model_repository",
    "base_revision",
    "attention_architecture",
    "thinking_template_id",
    "nonthinking_template_id",
    "compare_modes_separately",
    "consume_m6_frozen_results",
    "controlled_format_min_basis_points",
    "max_forced_close_basis_points",
    "min_thinking_score_basis_points",
    "nonthinking_regression_tolerance_basis_points",
    "generation"

{
  "$defs": {
    "M5ThinkingBudgetModeSummary": {
      "additionalProperties": false,
      "description": "Content-free aggregate for one controlled evaluation mode.",
      "properties": {
        "budget_forced_close_items": {
          "maximum": 200,
          "minimum": 0,
          "title": "Budget Forced Close Items",
          "type": "integer"
        },
        "evaluated_items": {
          "const": 200,
          "title": "Evaluated Items",
          "type": "integer"
        },
        "final_answer_correct_items": {
          "maximum": 200,
          "minimum": 0,
          "title": "Final Answer Correct Items",
          "type": "integer"
        },
        "final_answer_score_basis_points": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Final Answer Score Basis Points",
          "type": "integer"
        },
        "final_json_valid_items": {
          "maximum": 200,
          "minimum": 0,
          "title": "Final Json Valid Items",
          "type": "integer"
        },
        "forced_close_basis_points": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Forced Close Basis Points",
          "type": "integer"
        },
        "format_valid_basis_points": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Format Valid Basis Points",
          "type": "integer"
        },
        "format_valid_items": {
          "maximum": 200,
          "minimum": 0,
          "title": "Format Valid Items",
          "type": "integer"
        },
        "generated_tokens": {
          "minimum": 0,
          "title": "Generated Tokens",
          "type": "integer"
        },
        "injected_tokens": {
          "minimum": 0,
          "title": "Injected Tokens",
          "type": "integer"
        },
        "length_limited_items": {
          "maximum": 200,
          "minimum": 0,
          "title": "Length Limited Items",
          "type": "integer"
        },
        "mode": {
          "enum": [
            "thinking",
            "nonthinking"
          ],
          "title": "Mode",
          "type": "string"
        },
        "natural_close_basis_points": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Natural Close Basis Points",
          "type": "integer"
        },
        "natural_thinking_closed_items": {
          "maximum": 200,
          "minimum": 0,
          "title": "Natural Thinking Closed Items",
          "type": "integer"
        },
        "visible_reasoning_leakage_items": {
          "maximum": 200,
          "minimum": 0,
          "title": "Visible Reasoning Leakage Items",
          "type": "integer"
        }
      },
      "required": [
        "mode",
        "evaluated_items",
        "format_valid_items",
        "final_json_valid_items",
        "final_answer_correct_items",
        "visible_reasoning_leakage_items",
        "natural_thinking_closed_items",
        "budget_forced_close_items",
        "format_valid_basis_points",
        "final_answer_score_basis_points",
        "natural_close_basis_points",
        "forced_close_basis_points",
        "generated_tokens",
        "injected_tokens",
        "length_limited_items"
      ],
      "title": "M5ThinkingBudgetModeSummary",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Path-free public result for one protocol-v2 Base or Candidate evaluation.",
  "properties": {
    "adaptation": {
      "default": "full",
      "enum": [
        "full",
        "lora"
      ],
      "title": "Adaptation",
      "type": "string"
    },
    "adapter_sha256": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Adapter Sha256"
    },
    "attention_architecture": {
      "const": "gqa",
      "title": "Attention Architecture",
      "type": "string"
    },
    "config_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Config Sha256",
      "type": "string"
    },
    "duration_seconds": {
      "exclusiveMinimum": 0,
      "title": "Duration Seconds",
      "type": "number"
    },
    "evaluation_id": {
      "maxLength": 180,
      "minLength": 1,
      "title": "Evaluation Id",
      "type": "string"
    },
    "git_commit": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Git Commit",
      "type": "string"
    },
    "git_dirty": {
      "const": false,
      "title": "Git Dirty",
      "type": "boolean"
    },
    "gpu_name": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Gpu Name",
      "type": "string"
    },
    "model_kind": {
      "enum": [
        "base",
        "ablation_candidate",
        "formal_candidate",
        "lora_candidate"
      ],
      "title": "Model Kind",
      "type": "string"
    },
    "model_revision": {
      "enum": [
        "c1899de289a04d12100db370d81485cdf75e47ca",
        "b968826d9c46dd6066d109eabc6255188de91218"
      ],
      "title": "Model Revision",
      "type": "string"
    },
    "nonthinking": {
      "$ref": "#/$defs/M5ThinkingBudgetModeSummary"
    },
    "peak_allocated_bytes": {
      "exclusiveMinimum": 0,
      "title": "Peak Allocated Bytes",
      "type": "integer"
    },
    "peak_reserved_bytes": {
      "exclusiveMinimum": 0,
      "title": "Peak Reserved Bytes",
      "type": "integer"
    },
    "physical_gpu_index": {
      "minimum": 0,
      "title": "Physical Gpu Index",
      "type": "integer"
    },
    "protocol_version": {
      "const": "m5-thinking-budget-v2",
      "title": "Protocol Version",
      "type": "string"
    },
    "raw_results_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Raw Results Sha256",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "const": "succeeded",
      "title": "Status",
      "type": "string"
    },
    "suite_version": {
      "const": "m5-reasoning-dev-v1-53ddf557",
      "title": "Suite Version",
      "type": "string"
    },
    "thinking": {
      "$ref": "#/$defs/M5ThinkingBudgetModeSummary"
    },
    "thinking_fraction_basis_points": {
      "anyOf": [
        {
          "enum": [
            0,
            3000,
            5000
          ],
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Thinking Fraction Basis Points"
    },
    "training_run_id": {
      "anyOf": [
        {
          "maxLength": 180,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Training Run Id"
    },
    "training_seed": {
      "anyOf": [
        {
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Training Seed"
    }
  },
  "required": [
    "status",
    "evaluation_id",
    "protocol_version",
    "model_kind",
    "model_revision",
    "attention_architecture",
    "suite_version",
    "config_sha256",
    "git_commit",
    "git_dirty",
    "physical_gpu_index",
    "gpu_name",
    "duration_seconds",
    "peak_allocated_bytes",
    "peak_reserved_bytes",
    "thinking",
    "nonthinking",
    "raw_results_sha256"
  ],
  "title": "M5ThinkingBudgetEvaluationSummary",
  "type": "object"
}

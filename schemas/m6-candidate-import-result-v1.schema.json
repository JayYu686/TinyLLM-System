{
  "$defs": {
    "M6ModelIdentity": {
      "additionalProperties": false,
      "description": "Base or trained-model identity used by one M6 evaluation.",
      "properties": {
        "adaptation": {
          "enum": [
            "base",
            "full_sft",
            "lora"
          ],
          "title": "Adaptation",
          "type": "string"
        },
        "adapter_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adapter Sha256"
        },
        "attention_architecture": {
          "const": "gqa",
          "title": "Attention Architecture",
          "type": "string"
        },
        "base_revision": {
          "enum": [
            "c1899de289a04d12100db370d81485cdf75e47ca",
            "b968826d9c46dd6066d109eabc6255188de91218"
          ],
          "title": "Base Revision",
          "type": "string"
        },
        "dataset_manifest_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dataset Manifest Sha256"
        },
        "dataset_version": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dataset Version"
        },
        "model_artifact_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Model Artifact Sha256",
          "type": "string"
        },
        "model_parameters": {
          "exclusiveMinimum": 0,
          "title": "Model Parameters",
          "type": "integer"
        },
        "repository": {
          "enum": [
            "Qwen/Qwen3-0.6B",
            "Qwen/Qwen3-8B"
          ],
          "title": "Repository",
          "type": "string"
        },
        "role": {
          "enum": [
            "base",
            "candidate"
          ],
          "title": "Role",
          "type": "string"
        },
        "training_checkpoint_id": {
          "anyOf": [
            {
              "pattern": "^checkpoint-tokens-[0-9]{10}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Training Checkpoint Id"
        },
        "training_config_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Training Config Sha256"
        },
        "training_run_id": {
          "anyOf": [
            {
              "maxLength": 180,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Training Run Id"
        },
        "training_tokens": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 100000000,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Training Tokens"
        }
      },
      "required": [
        "role",
        "repository",
        "base_revision",
        "attention_architecture",
        "adaptation",
        "model_artifact_sha256",
        "model_parameters"
      ],
      "title": "M6ModelIdentity",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Verified M5 10M Full-SFT snapshot selected as the M6 Candidate.",
  "properties": {
    "checkpoint_manifest_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Checkpoint Manifest Sha256",
      "type": "string"
    },
    "config_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Config Sha256",
      "type": "string"
    },
    "model": {
      "$ref": "#/$defs/M6ModelIdentity"
    },
    "protocol_version": {
      "enum": [
        "m6-release-v1",
        "m6-release-v2",
        "m6-release-v3"
      ],
      "title": "Protocol Version",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "snapshot_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Snapshot Sha256",
      "type": "string"
    },
    "source_environment_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source Environment Sha256",
      "type": "string"
    },
    "source_git_commit": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Source Git Commit",
      "type": "string"
    },
    "source_hardware_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source Hardware Sha256",
      "type": "string"
    },
    "source_kind": {
      "default": "m5-formal-snapshot",
      "enum": [
        "m5-formal-snapshot",
        "m6-dual-mode-correction",
        "m6-gate-repair"
      ],
      "title": "Source Kind",
      "type": "string"
    },
    "source_result_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source Result Sha256",
      "type": "string"
    },
    "source_run_id": {
      "maxLength": 180,
      "minLength": 1,
      "title": "Source Run Id",
      "type": "string"
    },
    "status": {
      "const": "succeeded",
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "status",
    "protocol_version",
    "config_sha256",
    "source_run_id",
    "source_result_sha256",
    "source_git_commit",
    "source_environment_sha256",
    "source_hardware_sha256",
    "checkpoint_manifest_sha256",
    "snapshot_sha256",
    "model"
  ],
  "title": "M6CandidateImportResult",
  "type": "object"
}

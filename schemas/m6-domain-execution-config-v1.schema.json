{
  "$defs": {
    "M6NonthinkingGenerationConfig": {
      "additionalProperties": false,
      "description": "Pinned Qwen3 Non-thinking greedy-generation policy.",
      "properties": {
        "add_generation_prompt": {
          "const": true,
          "title": "Add Generation Prompt",
          "type": "boolean"
        },
        "do_sample": {
          "const": false,
          "title": "Do Sample",
          "type": "boolean"
        },
        "max_new_tokens": {
          "const": 512,
          "title": "Max New Tokens",
          "type": "integer"
        },
        "template_id": {
          "const": "qwen3-chatml-nonthinking-generation-v1",
          "title": "Template Id",
          "type": "string"
        },
        "template_sha256": {
          "const": "b9a510e2f016a112860e47056f770b04e5c93131cc4a8ecd47fcc950cfdb6273",
          "title": "Template Sha256",
          "type": "string"
        }
      },
      "required": [
        "template_id",
        "template_sha256",
        "add_generation_prompt",
        "max_new_tokens",
        "do_sample"
      ],
      "title": "M6NonthinkingGenerationConfig",
      "type": "object"
    },
    "M6OutputControlConfig": {
      "additionalProperties": false,
      "description": "Auditable output repair, evidence grounding, and Thinking continuation policy.",
      "properties": {
        "evidence_system_prompt_id": {
          "const": "evidence-grounding-bilingual-v1",
          "title": "Evidence System Prompt Id",
          "type": "string"
        },
        "evidence_system_prompt_sha256": {
          "const": "dff97b5e4f251f422c7b4b745ec1be6bf242b9e73020c403d05960f207f84618",
          "title": "Evidence System Prompt Sha256",
          "type": "string"
        },
        "json_repair_policy": {
          "enum": [
            "json-syntax-only-v1",
            "json-syntax-only-v2"
          ],
          "title": "Json Repair Policy",
          "type": "string"
        },
        "thinking_final_separator_id": {
          "const": "qwen3-thinking-final-separator-v1",
          "title": "Thinking Final Separator Id",
          "type": "string"
        },
        "thinking_final_separator_sha256": {
          "const": "75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070",
          "title": "Thinking Final Separator Sha256",
          "type": "string"
        }
      },
      "required": [
        "json_repair_policy",
        "evidence_system_prompt_id",
        "evidence_system_prompt_sha256",
        "thinking_final_separator_id",
        "thinking_final_separator_sha256"
      ],
      "title": "M6OutputControlConfig",
      "type": "object"
    },
    "M6ThinkingGenerationConfig": {
      "additionalProperties": false,
      "description": "Pinned Qwen3 Thinking generation and bounded-controller policy.",
      "properties": {
        "add_generation_prompt": {
          "const": true,
          "title": "Add Generation Prompt",
          "type": "boolean"
        },
        "do_sample": {
          "const": true,
          "title": "Do Sample",
          "type": "boolean"
        },
        "early_stopping_text": {
          "const": "\n\n Considering the limited time by the user, I have to give the solution based on the thinking directly now.\n</think>\n\n",
          "title": "Early Stopping Text",
          "type": "string"
        },
        "final_answer_batch_size": {
          "default": 1,
          "maximum": 4,
          "minimum": 1,
          "title": "Final Answer Batch Size",
          "type": "integer"
        },
        "final_answer_do_sample": {
          "default": true,
          "title": "Final Answer Do Sample",
          "type": "boolean"
        },
        "final_answer_max_new_tokens": {
          "const": 512,
          "title": "Final Answer Max New Tokens",
          "type": "integer"
        },
        "repetition_penalty": {
          "maximum": 2.0,
          "minimum": 1.0,
          "title": "Repetition Penalty",
          "type": "number"
        },
        "seed": {
          "enum": [
            20260809,
            20260810,
            20260811,
            20260812
          ],
          "title": "Seed",
          "type": "integer"
        },
        "temperature": {
          "exclusiveMinimum": 0.0,
          "maximum": 2.0,
          "title": "Temperature",
          "type": "number"
        },
        "template_id": {
          "const": "qwen3-chatml-thinking-generation-v1",
          "title": "Template Id",
          "type": "string"
        },
        "template_sha256": {
          "const": "7c37a1ab66f274f52208e50167e6cafbf00b6f5319207beca572e4b8cb1f8451",
          "title": "Template Sha256",
          "type": "string"
        },
        "thinking_budget_tokens": {
          "const": 1536,
          "title": "Thinking Budget Tokens",
          "type": "integer"
        },
        "top_k": {
          "const": 20,
          "title": "Top K",
          "type": "integer"
        },
        "top_p": {
          "exclusiveMinimum": 0.0,
          "maximum": 1.0,
          "title": "Top P",
          "type": "number"
        }
      },
      "required": [
        "template_id",
        "template_sha256",
        "add_generation_prompt",
        "thinking_budget_tokens",
        "final_answer_max_new_tokens",
        "do_sample",
        "temperature",
        "top_p",
        "top_k",
        "repetition_penalty",
        "seed",
        "early_stopping_text"
      ],
      "title": "M6ThinkingGenerationConfig",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Complete generation/scoring policy for the frozen domain suite.",
  "properties": {
    "batch_size": {
      "const": 4,
      "title": "Batch Size",
      "type": "integer"
    },
    "max_sequence_length": {
      "const": 1024,
      "title": "Max Sequence Length",
      "type": "integer"
    },
    "nonthinking": {
      "$ref": "#/$defs/M6NonthinkingGenerationConfig"
    },
    "output_control": {
      "anyOf": [
        {
          "$ref": "#/$defs/M6OutputControlConfig"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "scorer_policy": {
      "const": "tinyllm-domain-scorer-v1",
      "title": "Scorer Policy",
      "type": "string"
    },
    "thinking": {
      "$ref": "#/$defs/M6ThinkingGenerationConfig"
    }
  },
  "required": [
    "batch_size",
    "max_sequence_length",
    "scorer_policy",
    "thinking",
    "nonthinking"
  ],
  "title": "M6DomainExecutionConfig",
  "type": "object"
}

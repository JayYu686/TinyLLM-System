{
  "$defs": {
    "M5MixtureArtifactFile": {
      "additionalProperties": false,
      "description": "One immutable private mixture payload.",
      "properties": {
        "path": {
          "const": "sequences.npz",
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "exclusiveMinimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "size_bytes",
        "sha256"
      ],
      "title": "M5MixtureArtifactFile",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Independent authored remediation for evidence grounding and concise Thinking.",
  "properties": {
    "artifact": {
      "$ref": "#/$defs/M5MixtureArtifactFile"
    },
    "authored_domain_source_pairs": {
      "minimum": 600,
      "title": "Authored Domain Source Pairs",
      "type": "integer"
    },
    "authored_refusal_source_pairs": {
      "minimum": 280,
      "title": "Authored Refusal Source Pairs",
      "type": "integer"
    },
    "authored_source_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Authored Source Sha256",
      "type": "string"
    },
    "build_seed": {
      "maximum": 4294967295,
      "minimum": 0,
      "title": "Build Seed",
      "type": "integer"
    },
    "compact_reasoning_max_supervised_tokens": {
      "exclusiveMinimum": 0,
      "maximum": 256,
      "title": "Compact Reasoning Max Supervised Tokens",
      "type": "integer"
    },
    "content_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Content Sha256",
      "type": "string"
    },
    "dataset_name": {
      "const": "m6-gate-repair-mixture",
      "default": "m6-gate-repair-mixture",
      "title": "Dataset Name",
      "type": "string"
    },
    "diagnostic_protocol_version": {
      "const": "m6-release-v2",
      "title": "Diagnostic Protocol Version",
      "type": "string"
    },
    "domain_nonthinking_reuse_count": {
      "minimum": 0,
      "title": "Domain Nonthinking Reuse Count",
      "type": "integer"
    },
    "domain_nonthinking_supervised_tokens": {
      "const": 300000,
      "title": "Domain Nonthinking Supervised Tokens",
      "type": "integer"
    },
    "domain_thinking_reuse_count": {
      "minimum": 0,
      "title": "Domain Thinking Reuse Count",
      "type": "integer"
    },
    "domain_thinking_supervised_tokens": {
      "const": 300000,
      "title": "Domain Thinking Supervised Tokens",
      "type": "integer"
    },
    "evaluation_prompt_overlap_count": {
      "const": 0,
      "title": "Evaluation Prompt Overlap Count",
      "type": "integer"
    },
    "general_nonthinking_reuse_count": {
      "minimum": 0,
      "title": "General Nonthinking Reuse Count",
      "type": "integer"
    },
    "general_nonthinking_source_sequences": {
      "exclusiveMinimum": 0,
      "title": "General Nonthinking Source Sequences",
      "type": "integer"
    },
    "general_nonthinking_supervised_tokens": {
      "const": 400000,
      "title": "General Nonthinking Supervised Tokens",
      "type": "integer"
    },
    "mixture_version": {
      "pattern": "^m6-gate-repair-mixture-v1-[0-9a-f]{8}$",
      "title": "Mixture Version",
      "type": "string"
    },
    "nonthinking_sequence_count": {
      "exclusiveMinimum": 0,
      "title": "Nonthinking Sequence Count",
      "type": "integer"
    },
    "nonthinking_supervised_tokens": {
      "const": 700000,
      "title": "Nonthinking Supervised Tokens",
      "type": "integer"
    },
    "nonthinking_template_id": {
      "const": "qwen3-chatml-nonthinking-sft-v2",
      "title": "Nonthinking Template Id",
      "type": "string"
    },
    "nonthinking_template_sha256": {
      "const": "fba6724bd16200356794105a2273bbd42e777c8311ef1760059c6f0766171ca2",
      "title": "Nonthinking Template Sha256",
      "type": "string"
    },
    "pad_token_id": {
      "const": 151643,
      "title": "Pad Token Id",
      "type": "integer"
    },
    "parent_content_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Parent Content Sha256",
      "type": "string"
    },
    "parent_dataset_version": {
      "const": "m2-sft-v1-f82ff32e",
      "title": "Parent Dataset Version",
      "type": "string"
    },
    "partially_masked_sequences": {
      "maximum": 3,
      "minimum": 0,
      "title": "Partially Masked Sequences",
      "type": "integer"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "sequence_count": {
      "exclusiveMinimum": 0,
      "title": "Sequence Count",
      "type": "integer"
    },
    "sequence_length": {
      "const": 1024,
      "title": "Sequence Length",
      "type": "integer"
    },
    "source_consumed_evaluation_content": {
      "const": false,
      "title": "Source Consumed Evaluation Content",
      "type": "boolean"
    },
    "target_supervised_tokens": {
      "const": 1000000,
      "title": "Target Supervised Tokens",
      "type": "integer"
    },
    "thinking_fraction_basis_points": {
      "const": 3000,
      "title": "Thinking Fraction Basis Points",
      "type": "integer"
    },
    "thinking_sequence_count": {
      "exclusiveMinimum": 0,
      "title": "Thinking Sequence Count",
      "type": "integer"
    },
    "thinking_supervised_tokens": {
      "const": 300000,
      "title": "Thinking Supervised Tokens",
      "type": "integer"
    },
    "thinking_template_id": {
      "const": "qwen3-chatml-thinking-v1",
      "title": "Thinking Template Id",
      "type": "string"
    },
    "thinking_template_sha256": {
      "const": "4786143dbb7adb72a922d5efdcbe6596f2d65dcdc35d7bbf1b22830b795c2af9",
      "title": "Thinking Template Sha256",
      "type": "string"
    },
    "tokenizer_revision": {
      "const": "c1899de289a04d12100db370d81485cdf75e47ca",
      "title": "Tokenizer Revision",
      "type": "string"
    }
  },
  "required": [
    "mixture_version",
    "parent_dataset_version",
    "parent_content_sha256",
    "diagnostic_protocol_version",
    "source_consumed_evaluation_content",
    "evaluation_prompt_overlap_count",
    "authored_source_sha256",
    "tokenizer_revision",
    "nonthinking_template_id",
    "nonthinking_template_sha256",
    "thinking_template_id",
    "thinking_template_sha256",
    "sequence_length",
    "pad_token_id",
    "target_supervised_tokens",
    "thinking_fraction_basis_points",
    "nonthinking_supervised_tokens",
    "thinking_supervised_tokens",
    "general_nonthinking_supervised_tokens",
    "domain_nonthinking_supervised_tokens",
    "domain_thinking_supervised_tokens",
    "sequence_count",
    "nonthinking_sequence_count",
    "thinking_sequence_count",
    "general_nonthinking_source_sequences",
    "authored_domain_source_pairs",
    "authored_refusal_source_pairs",
    "general_nonthinking_reuse_count",
    "domain_nonthinking_reuse_count",
    "domain_thinking_reuse_count",
    "partially_masked_sequences",
    "compact_reasoning_max_supervised_tokens",
    "build_seed",
    "content_sha256",
    "artifact"
  ],
  "title": "M6GateRepairMixtureManifest",
  "type": "object"
}

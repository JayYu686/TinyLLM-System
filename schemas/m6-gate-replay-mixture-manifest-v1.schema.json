{
  "$defs": {
    "M5MixtureArtifactFile": {
      "additionalProperties": false,
      "description": "One immutable private mixture payload.",
      "properties": {
        "path": {
          "const": "sequences.npz",
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "exclusiveMinimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "size_bytes",
        "sha256"
      ],
      "title": "M5MixtureArtifactFile",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Continual-learning replay that preserves v2 gains while repairing its failures.",
  "properties": {
    "artifact": {
      "$ref": "#/$defs/M5MixtureArtifactFile"
    },
    "build_seed": {
      "maximum": 4294967295,
      "minimum": 0,
      "title": "Build Seed",
      "type": "integer"
    },
    "content_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Content Sha256",
      "type": "string"
    },
    "correction_manifest_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Correction Manifest Sha256",
      "type": "string"
    },
    "correction_mixture_version": {
      "const": "m5-dual-mode-correction-mixture-v1-4bc342d4",
      "title": "Correction Mixture Version",
      "type": "string"
    },
    "correction_nonthinking_reuse_count": {
      "minimum": 0,
      "title": "Correction Nonthinking Reuse Count",
      "type": "integer"
    },
    "correction_nonthinking_source_sequences": {
      "exclusiveMinimum": 0,
      "title": "Correction Nonthinking Source Sequences",
      "type": "integer"
    },
    "correction_nonthinking_supervised_tokens": {
      "const": 400000,
      "title": "Correction Nonthinking Supervised Tokens",
      "type": "integer"
    },
    "correction_thinking_reuse_count": {
      "minimum": 0,
      "title": "Correction Thinking Reuse Count",
      "type": "integer"
    },
    "correction_thinking_source_sequences": {
      "exclusiveMinimum": 0,
      "title": "Correction Thinking Source Sequences",
      "type": "integer"
    },
    "correction_thinking_supervised_tokens": {
      "const": 150000,
      "title": "Correction Thinking Supervised Tokens",
      "type": "integer"
    },
    "dataset_name": {
      "const": "m6-gate-replay-mixture",
      "default": "m6-gate-replay-mixture",
      "title": "Dataset Name",
      "type": "string"
    },
    "diagnostic_protocol_version": {
      "const": "m6-release-v2",
      "title": "Diagnostic Protocol Version",
      "type": "string"
    },
    "evaluation_prompt_overlap_count": {
      "const": 0,
      "title": "Evaluation Prompt Overlap Count",
      "type": "integer"
    },
    "mixture_version": {
      "pattern": "^m6-gate-replay-mixture-v1-[0-9a-f]{8}$",
      "title": "Mixture Version",
      "type": "string"
    },
    "nonthinking_sequence_count": {
      "exclusiveMinimum": 0,
      "title": "Nonthinking Sequence Count",
      "type": "integer"
    },
    "nonthinking_supervised_tokens": {
      "const": 700000,
      "title": "Nonthinking Supervised Tokens",
      "type": "integer"
    },
    "nonthinking_template_id": {
      "const": "qwen3-chatml-nonthinking-sft-v2",
      "title": "Nonthinking Template Id",
      "type": "string"
    },
    "nonthinking_template_sha256": {
      "const": "fba6724bd16200356794105a2273bbd42e777c8311ef1760059c6f0766171ca2",
      "title": "Nonthinking Template Sha256",
      "type": "string"
    },
    "pad_token_id": {
      "const": 151643,
      "title": "Pad Token Id",
      "type": "integer"
    },
    "parent_content_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Parent Content Sha256",
      "type": "string"
    },

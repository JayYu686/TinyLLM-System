      "type": "integer"
    },
    "repair_manifest_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Repair Manifest Sha256",
      "type": "string"
    },
    "repair_mixture_version": {
      "const": "m6-gate-repair-mixture-v1-be2aa7fa",

      "type": "integer"
    },
    "repair_nonthinking_source_sequences": {
      "exclusiveMinimum": 0,
      "title": "Repair Nonthinking Source Sequences",
      "type": "integer"
    },
    "repair_nonthinking_supervised_tokens": {
      "const": 300000,
      "title": "Repair Nonthinking Supervised Tokens",
      "type": "integer"
    },
    "repair_thinking_reuse_count": {
      "minimum": 0,
      "title": "Repair Thinking Reuse Count",
      "type": "integer"
    },
    "repair_thinking_source_sequences": {
      "exclusiveMinimum": 0,
      "title": "Repair Thinking Source Sequences",
      "type": "integer"
    },
    "repair_thinking_supervised_tokens": {
      "const": 150000,
      "title": "Repair Thinking Supervised Tokens",
      "type": "integer"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "sequence_count": {
      "exclusiveMinimum": 0,
      "title": "Sequence Count",
      "type": "integer"
    },
    "sequence_length": {
      "const": 1024,
      "title": "Sequence Length",
      "type": "integer"
    },
    "source_consumed_evaluation_content": {
      "const": false,
      "title": "Source Consumed Evaluation Content",
      "type": "boolean"
    },
    "target_supervised_tokens": {
      "const": 1000000,
      "title": "Target Supervised Tokens",
      "type": "integer"
    },
    "thinking_fraction_basis_points": {
      "const": 3000,
      "title": "Thinking Fraction Basis Points",
      "type": "integer"
    },
    "thinking_sequence_count": {
      "exclusiveMinimum": 0,
      "title": "Thinking Sequence Count",
      "type": "integer"
    },
    "thinking_supervised_tokens": {
      "const": 300000,
      "title": "Thinking Supervised Tokens",
      "type": "integer"
    },
    "thinking_template_id": {
      "const": "qwen3-chatml-thinking-v1",
      "title": "Thinking Template Id",
      "type": "string"
    },
    "thinking_template_sha256": {
      "const": "4786143dbb7adb72a922d5efdcbe6596f2d65dcdc35d7bbf1b22830b795c2af9",
      "title": "Thinking Template Sha256",
      "type": "string"
    },
    "tokenizer_revision": {
      "const": "c1899de289a04d12100db370d81485cdf75e47ca",

    "correction_mixture_version",
    "correction_manifest_sha256",
    "repair_mixture_version",
    "repair_manifest_sha256",
    "tokenizer_revision",
    "nonthinking_template_id",
    "nonthinking_template_sha256",
    "thinking_template_id",
    "thinking_template_sha256",
    "sequence_length",
    "pad_token_id",
    "target_supervised_tokens",
    "thinking_fraction_basis_points",
    "nonthinking_supervised_tokens",
    "thinking_supervised_tokens",
    "correction_nonthinking_supervised_tokens",
    "repair_nonthinking_supervised_tokens",
    "correction_thinking_supervised_tokens",
    "repair_thinking_supervised_tokens",
    "sequence_count",
    "nonthinking_sequence_count",
    "thinking_sequence_count",
    "correction_nonthinking_source_sequences",
    "repair_nonthinking_source_sequences",
    "correction_thinking_source_sequences",
    "repair_thinking_source_sequences",
    "correction_nonthinking_reuse_count",
    "repair_nonthinking_reuse_count",
    "correction_thinking_reuse_count",
    "repair_thinking_reuse_count",
    "partially_masked_sequences",
    "build_seed",
    "content_sha256",
    "artifact"
  ],
  "title": "M6GateReplayMixtureManifest",
  "type": "object"
}

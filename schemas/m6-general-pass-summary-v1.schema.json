{
  "$defs": {
    "M6GeneralResult": {
      "additionalProperties": false,
      "description": "Fixed equal-task mean over ARC-Easy, HellaSwag, and PIQA.",
      "properties": {
        "aggregate_basis_points": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Aggregate Basis Points",
          "type": "integer"
        },
        "aggregation": {
          "const": "equal-task-mean",
          "title": "Aggregation",
          "type": "string"
        },
        "harness_version": {
          "const": "0.4.12",
          "title": "Harness Version",
          "type": "string"
        },
        "metric": {
          "const": "acc_norm",
          "title": "Metric",
          "type": "string"
        },
        "tasks": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "$ref": "#/$defs/M6GeneralTaskResult"
            },
            {
              "$ref": "#/$defs/M6GeneralTaskResult"
            },
            {
              "$ref": "#/$defs/M6GeneralTaskResult"
            }
          ],
          "title": "Tasks",
          "type": "array"
        }
      },
      "required": [
        "harness_version",
        "metric",
        "aggregation",
        "tasks",
        "aggregate_basis_points"
      ],
      "title": "M6GeneralResult",
      "type": "object"
    },
    "M6GeneralTaskResult": {
      "additionalProperties": false,
      "description": "One full pinned lm-eval aggregate used for M6 regression checks.",
      "properties": {
        "acc": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Acc",
          "type": "number"
        },
        "acc_norm": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Acc Norm",
          "type": "number"
        },
        "acc_norm_stderr": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Acc Norm Stderr",
          "type": "number"
        },
        "acc_stderr": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Acc Stderr",
          "type": "number"
        },
        "samples": {
          "exclusiveMinimum": 0,
          "title": "Samples",
          "type": "integer"
        },
        "task": {
          "enum": [
            "tinyllm_arc_easy",
            "tinyllm_hellaswag",
            "tinyllm_piqa"
          ],
          "title": "Task",
          "type": "string"
        }
      },
      "required": [
        "task",
        "samples",
        "acc",
        "acc_stderr",
        "acc_norm",
        "acc_norm_stderr"
      ],
      "title": "M6GeneralTaskResult",
      "type": "object"
    },
    "M6ModelIdentity": {
      "additionalProperties": false,
      "description": "Base or trained-model identity used by one M6 evaluation.",
      "properties": {
        "adaptation": {
          "enum": [
            "base",
            "full_sft",
            "lora"
          ],
          "title": "Adaptation",
          "type": "string"
        },
        "adapter_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adapter Sha256"
        },
        "attention_architecture": {
          "const": "gqa",
          "title": "Attention Architecture",
          "type": "string"
        },
        "base_revision": {
          "enum": [
            "c1899de289a04d12100db370d81485cdf75e47ca",
            "b968826d9c46dd6066d109eabc6255188de91218"
          ],
          "title": "Base Revision",
          "type": "string"
        },
        "dataset_manifest_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dataset Manifest Sha256"
        },
        "dataset_version": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dataset Version"
        },
        "model_artifact_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Model Artifact Sha256",
          "type": "string"
        },
        "model_parameters": {
          "exclusiveMinimum": 0,
          "title": "Model Parameters",
          "type": "integer"
        },
        "repository": {
          "enum": [
            "Qwen/Qwen3-0.6B",
            "Qwen/Qwen3-8B"
          ],
          "title": "Repository",
          "type": "string"
        },
        "role": {
          "enum": [
            "base",
            "candidate"
          ],
          "title": "Role",
          "type": "string"
        },
        "training_checkpoint_id": {
          "anyOf": [
            {
              "pattern": "^checkpoint-tokens-[0-9]{10}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Training Checkpoint Id"
        },
        "training_config_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Training Config Sha256"
        },
        "training_run_id": {
          "anyOf": [
            {
              "maxLength": 180,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Training Run Id"
        },
        "training_tokens": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 100000000,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Training Tokens"
        }
      },
      "required": [
        "role",
        "repository",
        "base_revision",
        "attention_architecture",
        "adaptation",
        "model_artifact_sha256",
        "model_parameters"
      ],
      "title": "M6ModelIdentity",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One full Candidate general-regression pass with execution lineage.",
  "properties": {
    "config_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Config Sha256",
      "type": "string"
    },
    "duration_seconds": {
      "exclusiveMinimum": 0.0,
      "title": "Duration Seconds",
      "type": "number"
    },
    "environment_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Environment Sha256",
      "type": "string"
    },
    "evaluation_id": {
      "maxLength": 180,
      "minLength": 1,
      "title": "Evaluation Id",
      "type": "string"
    },
    "general": {
      "$ref": "#/$defs/M6GeneralResult"
    },
    "git_commit": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Git Commit",
      "type": "string"
    },
    "git_dirty": {
      "const": false,
      "title": "Git Dirty",
      "type": "boolean"
    },
    "gpu_name": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Gpu Name",
      "type": "string"
    },
    "hardware_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Hardware Sha256",
      "type": "string"
    },
    "model": {
      "$ref": "#/$defs/M6ModelIdentity"
    },
    "physical_gpu_index": {
      "minimum": 0,
      "title": "Physical Gpu Index",
      "type": "integer"
    },
    "protocol_version": {
      "enum": [
        "m6-release-v1",
        "m6-release-v2"
      ],
      "title": "Protocol Version",
      "type": "string"
    },
    "raw_results_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Raw Results Sha256",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "const": "succeeded",
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "status",
    "evaluation_id",
    "protocol_version",
    "config_sha256",
    "git_commit",
    "git_dirty",
    "model",
    "general",
    "physical_gpu_index",
    "gpu_name",
    "duration_seconds",
    "environment_sha256",
    "hardware_sha256",
    "raw_results_sha256"
  ],
  "title": "M6GeneralPassSummary",
  "type": "object"
}

{
  "additionalProperties": false,
  "description": "Base or trained-model identity used by one M6 evaluation.",
  "properties": {
    "adaptation": {
      "enum": [
        "base",
        "full_sft",
        "lora"
      ],
      "title": "Adaptation",
      "type": "string"
    },
    "adapter_sha256": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Adapter Sha256"
    },
    "attention_architecture": {
      "const": "gqa",
      "title": "Attention Architecture",
      "type": "string"
    },
    "base_revision": {
      "enum": [
        "c1899de289a04d12100db370d81485cdf75e47ca",
        "b968826d9c46dd6066d109eabc6255188de91218"
      ],
      "title": "Base Revision",
      "type": "string"
    },
    "dataset_manifest_sha256": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Dataset Manifest Sha256"
    },
    "dataset_version": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Dataset Version"
    },
    "model_artifact_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Model Artifact Sha256",
      "type": "string"
    },
    "model_parameters": {
      "exclusiveMinimum": 0,
      "title": "Model Parameters",
      "type": "integer"
    },
    "repository": {
      "enum": [
        "Qwen/Qwen3-0.6B",
        "Qwen/Qwen3-8B"
      ],
      "title": "Repository",
      "type": "string"
    },
    "role": {
      "enum": [
        "base",
        "candidate"
      ],
      "title": "Role",
      "type": "string"
    },
    "training_checkpoint_id": {
      "anyOf": [
        {
          "pattern": "^checkpoint-tokens-[0-9]{10}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Training Checkpoint Id"
    },
    "training_config_sha256": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Training Config Sha256"
    },
    "training_run_id": {
      "anyOf": [
        {
          "maxLength": 180,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Training Run Id"
    },
    "training_tokens": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "maximum": 100000000,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Training Tokens"
    }
  },
  "required": [
    "role",
    "repository",
    "base_revision",
    "attention_architecture",
    "adaptation",
    "model_artifact_sha256",
    "model_parameters"
  ],
  "title": "M6ModelIdentity",
  "type": "object"
}

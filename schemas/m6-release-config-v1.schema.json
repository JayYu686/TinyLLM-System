{
  "$defs": {
    "M6BootstrapConfig": {
      "additionalProperties": false,
      "description": "Paired cluster-bootstrap policy fixed before release-set evaluation.",
      "properties": {
        "confidence_basis_points": {
          "const": 9500,
          "title": "Confidence Basis Points",
          "type": "integer"
        },
        "percentile_method": {
          "const": "nearest-rank-v1",
          "title": "Percentile Method",
          "type": "string"
        },
        "replicates": {
          "const": 10000,
          "title": "Replicates",
          "type": "integer"
        },
        "resampling_unit": {
          "const": "bilingual-pair-or-english-singleton",
          "title": "Resampling Unit",
          "type": "string"
        },
        "seed": {
          "enum": [
            20260809,
            20260810,
            20260811,
            20260812,
            20260813,
            20260814,
            20260815
          ],
          "title": "Seed",
          "type": "integer"
        }
      },
      "required": [
        "seed",
        "replicates",
        "confidence_basis_points",
        "resampling_unit",
        "percentile_method"
      ],
      "title": "M6BootstrapConfig",
      "type": "object"
    },
    "M6DomainExecutionConfig": {
      "additionalProperties": false,
      "description": "Complete generation/scoring policy for the frozen domain suite.",
      "properties": {
        "batch_size": {
          "const": 4,
          "title": "Batch Size",
          "type": "integer"
        },
        "max_sequence_length": {
          "const": 1024,
          "title": "Max Sequence Length",
          "type": "integer"
        },
        "nonthinking": {
          "$ref": "#/$defs/M6NonthinkingGenerationConfig"
        },
        "output_control": {
          "anyOf": [
            {
              "$ref": "#/$defs/M6OutputControlConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "scorer_policy": {
          "const": "tinyllm-domain-scorer-v1",
          "title": "Scorer Policy",
          "type": "string"
        },
        "thinking": {
          "$ref": "#/$defs/M6ThinkingGenerationConfig"
        }
      },
      "required": [
        "batch_size",
        "max_sequence_length",
        "scorer_policy",
        "thinking",
        "nonthinking"
      ],
      "title": "M6DomainExecutionConfig",
      "type": "object"
    },
    "M6GateConfig": {
      "additionalProperties": false,
      "description": "Pre-registered Candidate thresholds expressed as integer basis points.",
      "properties": {
        "domain_ci_lower_min_exclusive_basis_points": {
          "const": 0,
          "title": "Domain Ci Lower Min Exclusive Basis Points",
          "type": "integer"
        },
        "domain_min_delta_basis_points": {
          "const": 300,
          "title": "Domain Min Delta Basis Points",
          "type": "integer"
        },
        "general_max_drop_basis_points": {
          "const": 200,
          "title": "General Max Drop Basis Points",
          "type": "integer"
        },
        "json_valid_min_basis_points": {
          "const": 9800,
          "title": "Json Valid Min Basis Points",
          "type": "integer"
        },
        "nonthinking_leakage_max_basis_points": {
          "const": 0,
          "title": "Nonthinking Leakage Max Basis Points",
          "type": "integer"
        },
        "production_gate_enabled": {
          "const": false,
          "title": "Production Gate Enabled",
          "type": "boolean"
        },
        "require_both_domain_modes": {
          "const": true,
          "title": "Require Both Domain Modes",
          "type": "boolean"
        },
        "require_complete_lineage": {
          "const": true,
          "title": "Require Complete Lineage",
          "type": "boolean"
        },
        "thinking_forced_close_max_basis_points": {
          "const": 1000,
          "title": "Thinking Forced Close Max Basis Points",
          "type": "integer"
        },
        "thinking_format_min_basis_points": {
          "const": 9900,
          "title": "Thinking Format Min Basis Points",
          "type": "integer"
        }
      },
      "required": [
        "domain_min_delta_basis_points",
        "domain_ci_lower_min_exclusive_basis_points",
        "general_max_drop_basis_points",
        "json_valid_min_basis_points",
        "thinking_format_min_basis_points",
        "thinking_forced_close_max_basis_points",
        "nonthinking_leakage_max_basis_points",
        "require_both_domain_modes",
        "require_complete_lineage",
        "production_gate_enabled"
      ],
      "title": "M6GateConfig",
      "type": "object"
    },
    "M6GeneralExecutionConfig": {
      "additionalProperties": false,
      "description": "Pinned Non-thinking lm-eval execution policy.",
      "properties": {
        "apply_chat_template": {
          "const": true,
          "title": "Apply Chat Template",
          "type": "boolean"
        },
        "batch_size": {
          "const": 8,
          "title": "Batch Size",
          "type": "integer"
        },
        "enable_thinking": {
          "const": false,
          "title": "Enable Thinking",
          "type": "boolean"
        },
        "harness_version": {
          "const": "0.4.12",
          "title": "Harness Version",
          "type": "string"
        },
        "log_samples": {
          "const": true,
          "title": "Log Samples",
          "type": "boolean"
        },
        "max_length": {
          "const": 1024,
          "title": "Max Length",
          "type": "integer"
        },
        "num_fewshot": {
          "const": 0,
          "title": "Num Fewshot",
          "type": "integer"
        },
        "tasks": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "$ref": "#/$defs/M6GeneralTaskConfig"
            },
            {
              "$ref": "#/$defs/M6GeneralTaskConfig"
            },
            {
              "$ref": "#/$defs/M6GeneralTaskConfig"
            }
          ],
          "title": "Tasks",
          "type": "array"
        },
        "tokenizer_chat_template_sha256": {
          "const": "a55ee1b1660128b7098723e0abcd92caa0788061051c62d51cbe87d9cf1974d8",
          "title": "Tokenizer Chat Template Sha256",
          "type": "string"
        }
      },
      "required": [
        "harness_version",
        "tokenizer_chat_template_sha256",
        "apply_chat_template",
        "enable_thinking",
        "num_fewshot",
        "batch_size",
        "max_length",
        "log_samples",
        "tasks"
      ],
      "title": "M6GeneralExecutionConfig",
      "type": "object"
    },
    "M6GeneralTaskConfig": {
      "additionalProperties": false,
      "description": "Pinned lm-eval Task Adapter and immutable dataset identity.",
      "properties": {
        "adapter_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Adapter Sha256",
          "type": "string"
        },
        "dataset_revision": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Dataset Revision",
          "type": "string"
        },
        "expected_samples": {
          "exclusiveMinimum": 0,
          "title": "Expected Samples",
          "type": "integer"
        },
        "task": {
          "enum": [
            "tinyllm_arc_easy",
            "tinyllm_hellaswag",
            "tinyllm_piqa"
          ],
          "title": "Task",
          "type": "string"
        }
      },
      "required": [
        "task",
        "adapter_sha256",
        "dataset_revision",
        "expected_samples"
      ],
      "title": "M6GeneralTaskConfig",
      "type": "object"
    },
    "M6NonthinkingGenerationConfig": {
      "additionalProperties": false,
      "description": "Pinned Qwen3 Non-thinking greedy-generation policy.",
      "properties": {
        "add_generation_prompt": {
          "const": true,
          "title": "Add Generation Prompt",
          "type": "boolean"
        },
        "do_sample": {
          "const": false,
          "title": "Do Sample",
          "type": "boolean"
        },
        "max_new_tokens": {
          "const": 512,
          "title": "Max New Tokens",
          "type": "integer"
        },
        "template_id": {
          "const": "qwen3-chatml-nonthinking-generation-v1",
          "title": "Template Id",
          "type": "string"
        },
        "template_sha256": {
          "const": "b9a510e2f016a112860e47056f770b04e5c93131cc4a8ecd47fcc950cfdb6273",
          "title": "Template Sha256",
          "type": "string"
        }
      },
      "required": [
        "template_id",
        "template_sha256",
        "add_generation_prompt",
        "max_new_tokens",
        "do_sample"
      ],
      "title": "M6NonthinkingGenerationConfig",
      "type": "object"
    },
    "M6OutputControlConfig": {
      "additionalProperties": false,
      "description": "Auditable output repair, evidence grounding, and Thinking continuation policy.",
      "properties": {
        "evidence_system_prompt_id": {
          "const": "evidence-grounding-bilingual-v1",
          "title": "Evidence System Prompt Id",
          "type": "string"
        },
        "evidence_system_prompt_sha256": {
          "const": "dff97b5e4f251f422c7b4b745ec1be6bf242b9e73020c403d05960f207f84618",
          "title": "Evidence System Prompt Sha256",
          "type": "string"
        },
        "json_decoder_id": {
          "anyOf": [
            {
              "const": "xgrammar-json-shape-v1",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Json Decoder Id"
        },
        "json_decoder_version": {
          "anyOf": [
            {
              "const": "0.2.4",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Json Decoder Version"
        },
        "json_repair_policy": {
          "enum": [
            "json-syntax-only-v1",
            "json-syntax-only-v2",
            "json-syntax-only-v3"
          ],
          "title": "Json Repair Policy",
          "type": "string"
        },
        "json_schema_policy": {
          "anyOf": [
            {
              "const": "expected-json-shape-no-values-v1",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Json Schema Policy"
        },
        "nonthinking_stop_policy": {
          "anyOf": [
            {
              "const": "truncate-before-first-thinking-tag-v1",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Nonthinking Stop Policy"
        },
        "nonthinking_stop_strings": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "const": "<think>",
                  "type": "string"
                },
                {
                  "const": "</think>",
                  "type": "string"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Nonthinking Stop Strings"
        },
        "thinking_continuation_context_id": {
          "const": "qwen3-visible-text-retokenize-v1",
          "title": "Thinking Continuation Context Id",
          "type": "string"
        },
        "thinking_final_separator_id": {
          "const": "qwen3-thinking-final-separator-v1",
          "title": "Thinking Final Separator Id",
          "type": "string"
        },
        "thinking_final_separator_sha256": {
          "const": "75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070",
          "title": "Thinking Final Separator Sha256",
          "type": "string"
        },
        "thinking_final_stop_policy": {
          "anyOf": [
            {
              "const": "truncate-before-next-thinking-tag-v1",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Thinking Final Stop Policy"
        },
        "thinking_final_stop_strings": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "const": "<think>",
                  "type": "string"
                },
                {
                  "const": "</think>",
                  "type": "string"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Thinking Final Stop Strings"
        }
      },
      "required": [
        "json_repair_policy",
        "evidence_system_prompt_id",
        "evidence_system_prompt_sha256",
        "thinking_final_separator_id",
        "thinking_final_separator_sha256",
        "thinking_continuation_context_id"
      ],
      "title": "M6OutputControlConfig",
      "type": "object"
    },
    "M6ThinkingGenerationConfig": {
      "additionalProperties": false,
      "description": "Pinned Qwen3 Thinking generation and bounded-controller policy.",
      "properties": {
        "add_generation_prompt": {
          "const": true,
          "title": "Add Generation Prompt",
          "type": "boolean"
        },
        "do_sample": {
          "const": true,
          "title": "Do Sample",
          "type": "boolean"
        },
        "early_stopping_text": {
          "const": "\n\n Considering the limited time by the user, I have to give the solution based on the thinking directly now.\n</think>\n\n",
          "title": "Early Stopping Text",
          "type": "string"
        },
        "final_answer_batch_size": {
          "default": 1,
          "maximum": 4,
          "minimum": 1,
          "title": "Final Answer Batch Size",
          "type": "integer"
        },
        "final_answer_do_sample": {
          "default": true,
          "title": "Final Answer Do Sample",
          "type": "boolean"
        },
        "final_answer_max_new_tokens": {
          "const": 512,
          "title": "Final Answer Max New Tokens",
          "type": "integer"
        },
        "repetition_penalty": {
          "maximum": 2.0,
          "minimum": 1.0,
          "title": "Repetition Penalty",
          "type": "number"
        },
        "seed": {
          "enum": [
            20260809,
            20260810,
            20260811,
            20260812,
            20260813,
            20260814,
            20260815
          ],
          "title": "Seed",
          "type": "integer"
        },
        "temperature": {
          "exclusiveMinimum": 0.0,
          "maximum": 2.0,
          "title": "Temperature",
          "type": "number"
        },
        "template_id": {
          "const": "qwen3-chatml-thinking-generation-v1",
          "title": "Template Id",
          "type": "string"
        },
        "template_sha256": {
          "const": "7c37a1ab66f274f52208e50167e6cafbf00b6f5319207beca572e4b8cb1f8451",
          "title": "Template Sha256",
          "type": "string"
        },
        "thinking_budget_tokens": {
          "const": 1536,
          "title": "Thinking Budget Tokens",
          "type": "integer"
        },
        "top_k": {
          "const": 20,
          "title": "Top K",
          "type": "integer"
        },
        "top_p": {
          "exclusiveMinimum": 0.0,
          "maximum": 1.0,
          "title": "Top P",
          "type": "number"
        }
      },
      "required": [
        "template_id",
        "template_sha256",
        "add_generation_prompt",
        "thinking_budget_tokens",
        "final_answer_max_new_tokens",
        "do_sample",
        "temperature",
        "top_p",
        "top_k",
        "repetition_penalty",
        "seed",
        "early_stopping_text"
      ],
      "title": "M6ThinkingGenerationConfig",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Frozen M6 comparison policy, independent from model outputs.",
  "properties": {
    "bootstrap": {
      "$ref": "#/$defs/M6BootstrapConfig"
    },
    "compare_modes_separately": {
      "const": true,
      "title": "Compare Modes Separately",
      "type": "boolean"
    },
    "domain_execution": {
      "$ref": "#/$defs/M6DomainExecutionConfig"
    },
    "expected_domain_items": {
      "const": 300,
      "title": "Expected Domain Items",
      "type": "integer"
    },
    "expected_languages": {
      "const": "en-210_zh-90",
      "title": "Expected Languages",
      "type": "string"
    },
    "gate": {
      "$ref": "#/$defs/M6GateConfig"
    },
    "general_aggregation": {
      "const": "equal-task-mean",
      "title": "General Aggregation",
      "type": "string"
    },
    "general_execution": {
      "$ref": "#/$defs/M6GeneralExecutionConfig"
    },
    "general_metric": {
      "const": "acc_norm",
      "title": "General Metric",
      "type": "string"
    },
    "general_tasks": {
      "maxItems": 3,
      "minItems": 3,
      "prefixItems": [
        {
          "enum": [
            "tinyllm_arc_easy",
            "tinyllm_hellaswag",
            "tinyllm_piqa"
          ],
          "type": "string"
        },
        {
          "enum": [
            "tinyllm_arc_easy",
            "tinyllm_hellaswag",
            "tinyllm_piqa"
          ],
          "type": "string"
        },
        {
          "enum": [
            "tinyllm_arc_easy",
            "tinyllm_hellaswag",
            "tinyllm_piqa"
          ],
          "type": "string"
        }
      ],
      "title": "General Tasks",
      "type": "array"
    },
    "protocol_version": {
      "enum": [
        "m6-release-v1",
        "m6-release-v2",
        "m6-release-v3",
        "m6-release-v4",
        "m6-release-v5",
        "m6-release-v6",
        "m6-release-v7"
      ],
      "title": "Protocol Version",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "suite_content_sha256": {
      "enum": [
        "83bdd8ef24dfa2bae0a997570594e7243f81ec3891a420458dd29b10f5e7af27",
        "c0c948cc5282cfaa15baae689ddf0bf51c0d59ece6e01554df480bc16a6d3842",
        "2b167ce67a3761558bf2c556131d86eb572dc5d36e533a668a539a78eb86d6e2",
        "bac25144d53d186693514f6a421e3894a820bddb039c75ca29c2484190b7913a",
        "3e5fffd7d408a6d2d237f4da7f5e3ecfb72523bd5f9e42b6e74f24e9199b1bfe",
        "c34f63a87c05910f421db19c71eede7368328028f81bbf08870070bb2fba6002",
        "b82cbca1821cadbaf4872636e89c61cef730ebe09413f9c63f34993302b6f955"
      ],
      "title": "Suite Content Sha256",
      "type": "string"
    },
    "suite_version": {
      "enum": [
        "tinyllm-domain-v1-83bdd8ef",
        "tinyllm-domain-holdout-v1-c0c948cc",
        "tinyllm-domain-holdout-v1-2b167ce6",
        "tinyllm-domain-final-audit-v1-bac25144",
        "tinyllm-domain-json-audit-v1-3e5fffd7",
        "tinyllm-domain-output-boundary-audit-v1-c34f63a8",
        "tinyllm-domain-thinking-boundary-audit-v1-b82cbca1"
      ],
      "title": "Suite Version",
      "type": "string"
    }
  },
  "required": [
    "protocol_version",
    "suite_version",
    "suite_content_sha256",
    "expected_domain_items",
    "expected_languages",
    "compare_modes_separately",
    "general_metric",
    "general_aggregation",
    "general_tasks",
    "domain_execution",
    "general_execution",
    "bootstrap",
    "gate"
  ],
  "title": "M6ReleaseConfig",
  "type": "object"
}

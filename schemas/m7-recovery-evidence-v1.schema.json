{
  "additionalProperties": false,
  "description": "Managed-backend crash and restart evidence.",
  "properties": {
    "backend_recovery_milliseconds": {
      "minimum": 0,
      "title": "Backend Recovery Milliseconds",
      "type": "integer"
    },
    "backend_restart_count": {
      "minimum": 1,
      "title": "Backend Restart Count",
      "type": "integer"
    },
    "candidate_model_version": {
      "pattern": "^qwen3-(0-6b|8b)-m6-[0-9a-f]{8}$",
      "title": "Candidate Model Version",
      "type": "string"
    },
    "environment_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Environment Sha256",
      "type": "string"
    },
    "evaluated_at": {
      "format": "date-time",
      "title": "Evaluated At",
      "type": "string"
    },
    "evidence_id": {
      "pattern": "^m7-recovery-[0-9a-f]{8}$",
      "title": "Evidence Id",
      "type": "string"
    },
    "model_artifact_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Model Artifact Sha256",
      "type": "string"
    },
    "passed": {
      "title": "Passed",
      "type": "boolean"
    },
    "post_recovery_request_succeeded": {
      "title": "Post Recovery Request Succeeded",
      "type": "boolean"
    },
    "readiness_failure_milliseconds": {
      "minimum": 0,
      "title": "Readiness Failure Milliseconds",
      "type": "integer"
    },
    "ready_before_failure": {
      "title": "Ready Before Failure",
      "type": "boolean"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "serving_config_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Serving Config Sha256",
      "type": "string"
    }
  },
  "required": [
    "evidence_id",
    "evaluated_at",
    "candidate_model_version",
    "model_artifact_sha256",
    "serving_config_sha256",
    "environment_sha256",
    "ready_before_failure",
    "readiness_failure_milliseconds",
    "backend_recovery_milliseconds",
    "backend_restart_count",
    "post_recovery_request_succeeded",
    "passed"
  ],
  "title": "M7RecoveryEvidence",
  "type": "object"
}

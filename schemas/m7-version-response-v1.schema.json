{
  "additionalProperties": false,
  "description": "Public version and active deployment identity.",
  "properties": {
    "candidate_model_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Candidate Model Version"
    },
    "deployment_status": {
      "enum": [
        "Candidate",
        "Production",
        "Evaluation"
      ],
      "title": "Deployment Status",
      "type": "string"
    },
    "evaluation_subject_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Evaluation Subject Sha256"
    },
    "model": {
      "title": "Model",
      "type": "string"
    },
    "model_artifact_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Model Artifact Sha256",
      "type": "string"
    },
    "production_record_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Production Record Sha256"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "service": {
      "const": "tinyllm-gateway",
      "default": "tinyllm-gateway",
      "title": "Service",
      "type": "string"
    },
    "version": {
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "version",
    "model",
    "deployment_status",
    "model_artifact_sha256"
  ],
  "title": "VersionResponse",
  "type": "object"
}

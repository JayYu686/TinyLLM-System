{
  "$defs": {
    "AgentMessage": {
      "additionalProperties": false,
      "description": "Text and tool-result message accepted by the bounded Agent API.",
      "properties": {
        "content": {
          "anyOf": [
            {
              "maxLength": 262144,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content"
        },
        "name": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "role": {
          "enum": [
            "system",
            "user",
            "assistant",
            "tool"
          ],
          "title": "Role",
          "type": "string"
        },
        "tool_call_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Call Id"
        },
        "tool_calls": {
          "anyOf": [
            {
              "items": {
                "additionalProperties": true,
                "type": "object"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Calls"
        }
      },
      "required": [
        "role"
      ],
      "title": "AgentMessage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Public request contract for one bounded Agent execution.",
  "properties": {
    "max_steps": {
      "default": 8,
      "maximum": 8,
      "minimum": 1,
      "title": "Max Steps",
      "type": "integer"
    },
    "mcp_server_ids": {
      "default": [
        "tinyllm-devops"
      ],
      "items": {
        "type": "string"
      },
      "maxItems": 8,
      "minItems": 1,
      "title": "Mcp Server Ids",
      "type": "array"
    },
    "messages": {
      "items": {
        "$ref": "#/$defs/AgentMessage"
      },
      "maxItems": 64,
      "minItems": 1,
      "title": "Messages",
      "type": "array"
    },
    "mode": {
      "default": "nonthinking",
      "enum": [
        "thinking",
        "nonthinking"
      ],
      "title": "Mode",
      "type": "string"
    },
    "model": {
      "default": "production",
      "maxLength": 180,
      "minLength": 1,
      "title": "Model",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "messages"
  ],
  "title": "AgentRunRequest",
  "type": "object"
}

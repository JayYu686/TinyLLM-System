{
  "additionalProperties": false,
  "description": "Bounded runtime configuration for one resumable Agent suite evaluation.",
  "properties": {
    "bearer_token_env": {
      "pattern": "^TINYLLM_[A-Z0-9_]{3,100}$",
      "title": "Bearer Token Env",
      "type": "string"
    },
    "config_id": {
      "pattern": "^m9-agent-eval-[a-z0-9-]{3,80}$",
      "title": "Config Id",
      "type": "string"
    },
    "gateway_base_url": {
      "maxLength": 256,
      "title": "Gateway Base Url",
      "type": "string"
    },
    "max_concurrency": {
      "default": 2,
      "maximum": 8,
      "minimum": 1,
      "title": "Max Concurrency",
      "type": "integer"
    },
    "max_steps": {
      "default": 8,
      "maximum": 8,
      "minimum": 1,
      "title": "Max Steps",
      "type": "integer"
    },
    "max_tool_calls": {
      "default": 12,
      "maximum": 12,
      "minimum": 1,
      "title": "Max Tool Calls",
      "type": "integer"
    },
    "mode": {
      "default": "nonthinking",
      "enum": [
        "nonthinking",
        "thinking"
      ],
      "title": "Mode",
      "type": "string"
    },
    "model": {
      "default": "production",
      "maxLength": 180,
      "minLength": 1,
      "title": "Model",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "task_timeout_seconds": {
      "default": 120.0,
      "exclusiveMinimum": 0,
      "maximum": 600,
      "title": "Task Timeout Seconds",
      "type": "number"
    }
  },
  "required": [
    "config_id",
    "gateway_base_url",
    "bearer_token_env"
  ],
  "title": "AgentEvalRunConfig",
  "type": "object"
}

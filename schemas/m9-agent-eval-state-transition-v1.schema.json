{
  "$defs": {
    "AgentEvalStateEntry": {
      "additionalProperties": false,
      "description": "One deterministic key/value entry in an evaluation environment state.",
      "properties": {
        "key": {
          "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
          "title": "Key",
          "type": "string"
        },
        "value": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "key",
        "value"
      ],
      "title": "AgentEvalStateEntry",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Expected state change caused by one accepted tool call.",
  "properties": {
    "occurrence": {
      "default": 1,
      "maximum": 12,
      "minimum": 1,
      "title": "Occurrence",
      "type": "integer"
    },
    "set_state": {
      "default": [],
      "items": {
        "$ref": "#/$defs/AgentEvalStateEntry"
      },
      "maxItems": 16,
      "title": "Set State",
      "type": "array"
    },
    "tool_name": {
      "pattern": "^[a-z][a-z0-9_]{1,63}$",
      "title": "Tool Name",
      "type": "string"
    },
    "when_status": {
      "enum": [
        "succeeded",
        "failed"
      ],
      "title": "When Status",
      "type": "string"
    }
  },
  "required": [
    "tool_name",
    "when_status"
  ],
  "title": "AgentEvalStateTransition",
  "type": "object"
}

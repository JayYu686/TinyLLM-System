{
  "$defs": {
    "AgentEvalAllowedTrajectory": {
      "additionalProperties": false,
      "description": "One accepted ordered trace; equal parallel groups may occur in any order.",
      "properties": {
        "calls": {
          "default": [],
          "items": {
            "$ref": "#/$defs/AgentEvalExpectedCall"
          },
          "maxItems": 12,
          "title": "Calls",
          "type": "array"
        },
        "requires_clarification": {
          "default": false,
          "title": "Requires Clarification",
          "type": "boolean"
        },
        "requires_final_answer": {
          "default": true,
          "title": "Requires Final Answer",
          "type": "boolean"
        },
        "trajectory_id": {
          "pattern": "^trajectory-[a-z0-9-]{1,80}$",
          "title": "Trajectory Id",
          "type": "string"
        }
      },
      "required": [
        "trajectory_id"
      ],
      "title": "AgentEvalAllowedTrajectory",
      "type": "object"
    },
    "AgentEvalExpectedCall": {
      "additionalProperties": false,
      "description": "One semantically required tool invocation in an accepted trace.",
      "properties": {
        "argument_match": {
          "default": "exact",
          "enum": [
            "exact",
            "subset"
          ],
          "title": "Argument Match",
          "type": "string"
        },
        "arguments": {
          "additionalProperties": true,
          "title": "Arguments",
          "type": "object"
        },
        "parallel_group": {
          "anyOf": [
            {
              "maximum": 8,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parallel Group"
        },
        "result_status": {
          "default": "succeeded",
          "enum": [
            "succeeded",
            "failed"
          ],
          "title": "Result Status",
          "type": "string"
        },
        "tool_name": {
          "pattern": "^[a-z][a-z0-9_]{1,63}$",
          "title": "Tool Name",
          "type": "string"
        }
      },
      "required": [
        "tool_name",
        "arguments"
      ],
      "title": "AgentEvalExpectedCall",
      "type": "object"
    },
    "AgentEvalFailureInjection": {
      "additionalProperties": false,
      "description": "Deterministic tool failure injected by the evaluation environment.",
      "properties": {
        "error_code": {
          "pattern": "^[A-Z][A-Z0-9_]{2,63}$",
          "title": "Error Code",
          "type": "string"
        },
        "message": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "occurrence": {
          "default": 1,
          "maximum": 12,
          "minimum": 1,
          "title": "Occurrence",
          "type": "integer"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        },
        "tool_name": {
          "pattern": "^[a-z][a-z0-9_]{1,63}$",
          "title": "Tool Name",
          "type": "string"
        }
      },
      "required": [
        "tool_name",
        "error_code",
        "retryable",
        "message"
      ],
      "title": "AgentEvalFailureInjection",
      "type": "object"
    },
    "AgentEvalFinalAssertions": {
      "additionalProperties": false,
      "description": "Machine-checkable final-answer and security assertions.",
      "properties": {
        "expected_terminal_state": {
          "default": "succeeded",
          "enum": [
            "succeeded",
            "waiting_approval"
          ],
          "title": "Expected Terminal State",
          "type": "string"
        },
        "forbidden_terms": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "title": "Forbidden Terms",
          "type": "array"
        },
        "require_approval_before_write": {
          "default": false,
          "title": "Require Approval Before Write",
          "type": "boolean"
        },
        "require_clarification": {
          "default": false,
          "title": "Require Clarification",
          "type": "boolean"
        },
        "require_evidence_citation": {
          "default": false,
          "title": "Require Evidence Citation",
          "type": "boolean"
        },
        "required_terms": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "title": "Required Terms",
          "type": "array"
        }
      },
      "title": "AgentEvalFinalAssertions",
      "type": "object"
    },
    "AgentEvalStateEntry": {
      "additionalProperties": false,
      "description": "One deterministic key/value entry in an evaluation environment state.",
      "properties": {
        "key": {
          "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
          "title": "Key",
          "type": "string"
        },
        "value": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "key",
        "value"
      ],
      "title": "AgentEvalStateEntry",
      "type": "object"
    },
    "AgentEvalStateTransition": {
      "additionalProperties": false,
      "description": "Expected state change caused by one accepted tool call.",
      "properties": {
        "occurrence": {
          "default": 1,
          "maximum": 12,
          "minimum": 1,
          "title": "Occurrence",
          "type": "integer"
        },
        "set_state": {
          "default": [],
          "items": {
            "$ref": "#/$defs/AgentEvalStateEntry"
          },
          "maxItems": 16,
          "title": "Set State",
          "type": "array"
        },
        "tool_name": {
          "pattern": "^[a-z][a-z0-9_]{1,63}$",
          "title": "Tool Name",
          "type": "string"
        },
        "when_status": {
          "enum": [
            "succeeded",
            "failed"
          ],
          "title": "When Status",
          "type": "string"
        }
      },
      "required": [
        "tool_name",
        "when_status"
      ],
      "title": "AgentEvalStateTransition",
      "type": "object"
    },
    "AgentMessage": {
      "additionalProperties": false,
      "description": "Text and tool-result message accepted by the bounded Agent API.",
      "properties": {
        "content": {
          "anyOf": [
            {
              "maxLength": 262144,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content"
        },
        "name": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "role": {
          "enum": [
            "system",
            "user",
            "assistant",
            "tool"
          ],
          "title": "Role",
          "type": "string"
        },
        "tool_call_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Call Id"
        },
        "tool_calls": {
          "anyOf": [
            {
              "items": {
                "additionalProperties": true,
                "type": "object"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Calls"
        }
      },
      "required": [
        "role"
      ],
      "title": "AgentMessage",
      "type": "object"
    },
    "AgentToolDefinition": {
      "additionalProperties": false,
      "description": "Locally authorized tool metadata discovered from an MCP Server.",
      "properties": {
        "description": {
          "anyOf": [
            {
              "maxLength": 4096,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "input_schema": {
          "additionalProperties": true,
          "title": "Input Schema",
          "type": "object"
        },
        "server_id": {
          "pattern": "^[a-z][a-z0-9-]{2,63}$",
          "title": "Server Id",
          "type": "string"
        },
        "tool_name": {
          "pattern": "^[a-z][a-z0-9_]{1,63}$",
          "title": "Tool Name",
          "type": "string"
        }
      },
      "required": [
        "server_id",
        "tool_name",
        "input_schema"
      ],
      "title": "AgentToolDefinition",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One sealed, deterministic DevOps Agent evaluation task.",
  "properties": {
    "allowed_trajectories": {
      "items": {
        "$ref": "#/$defs/AgentEvalAllowedTrajectory"
      },
      "maxItems": 8,
      "minItems": 1,
      "title": "Allowed Trajectories",
      "type": "array"
    },
    "available_tools": {
      "items": {
        "$ref": "#/$defs/AgentToolDefinition"
      },
      "maxItems": 7,
      "minItems": 1,
      "title": "Available Tools",
      "type": "array"
    },
    "category": {
      "enum": [
        "single_tool",
        "no_tool",
        "wrong_tool_irrelevance",
        "missing_argument_clarification",
        "sequential_multi_step",
        "parallel_independent_tools",
        "tool_failure_recovery",
        "grounding_approval_security"
      ],
      "title": "Category",
      "type": "string"
    },
    "cluster_id": {
      "pattern": "^cluster-[a-z0-9-]{3,80}$",
      "title": "Cluster Id",
      "type": "string"
    },
    "failure_injection": {
      "anyOf": [
        {
          "$ref": "#/$defs/AgentEvalFailureInjection"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "final_assertions": {
      "$ref": "#/$defs/AgentEvalFinalAssertions"
    },
    "initial_state": {
      "default": [],
      "items": {
        "$ref": "#/$defs/AgentEvalStateEntry"
      },
      "maxItems": 32,
      "title": "Initial State",
      "type": "array"
    },
    "language": {
      "enum": [
        "en",
        "zh"
      ],
      "title": "Language",
      "type": "string"
    },
    "messages": {
      "items": {
        "$ref": "#/$defs/AgentMessage"
      },
      "maxItems": 8,
      "minItems": 1,
      "title": "Messages",
      "type": "array"
    },
    "prompt_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Prompt Sha256",
      "type": "string"
    },
    "reference_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Reference Sha256",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "split": {
      "enum": [
        "dev",
        "release"
      ],
      "title": "Split",
      "type": "string"
    },
    "state_transitions": {
      "default": [],
      "items": {
        "$ref": "#/$defs/AgentEvalStateTransition"
      },
      "maxItems": 16,
      "title": "State Transitions",
      "type": "array"
    },
    "task_id": {
      "pattern": "^m9-(?:dev|release)-(?:en|zh)-[a-z0-9-]+-[0-9]{3}$",
      "title": "Task Id",
      "type": "string"
    },
    "tool_schema_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Tool Schema Sha256",
      "type": "string"
    }
  },
  "required": [
    "task_id",
    "split",
    "category",
    "cluster_id",
    "language",
    "messages",
    "available_tools",
    "allowed_trajectories",
    "final_assertions",
    "prompt_sha256",
    "tool_schema_sha256",
    "reference_sha256"
  ],
  "title": "AgentEvalTask",
  "type": "object"
}

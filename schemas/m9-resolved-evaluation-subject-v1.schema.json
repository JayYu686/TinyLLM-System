{
  "$defs": {
    "M10AdapterRoutingPolicy": {
      "additionalProperties": false,
      "description": "Frozen specialization route: exact DevOps catalog uses LoRA, everything else Base.",
      "properties": {
        "adapter_tool_names": {
          "default": [
            "apply_sandbox_config_patch",
            "get_run",
            "inspect_config",
            "list_runs",
            "query_metrics",
            "read_log_excerpt",
            "search_evidence"
          ],
          "items": {
            "type": "string"
          },
          "title": "Adapter Tool Names",
          "type": "array"
        },
        "match_mode": {
          "const": "exact_tool_name_set",
          "default": "exact_tool_name_set",
          "title": "Match Mode",
          "type": "string"
        },
        "matched_route": {
          "const": "adapter",
          "default": "adapter",
          "title": "Matched Route",
          "type": "string"
        },
        "policy_version": {
          "const": "m10-devops-adapter-route-v1",
          "default": "m10-devops-adapter-route-v1",
          "title": "Policy Version",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "unmatched_route": {
          "const": "base",
          "default": "base",
          "title": "Unmatched Route",
          "type": "string"
        }
      },
      "title": "M10AdapterRoutingPolicy",
      "type": "object"
    },
    "M6ModelIdentity": {
      "additionalProperties": false,
      "description": "Base or trained-model identity used by one M6 evaluation.",
      "properties": {
        "adaptation": {
          "enum": [
            "base",
            "full_sft",
            "lora"
          ],
          "title": "Adaptation",
          "type": "string"
        },
        "adapter_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adapter Sha256"
        },
        "attention_architecture": {
          "const": "gqa",
          "title": "Attention Architecture",
          "type": "string"
        },
        "base_revision": {
          "enum": [
            "c1899de289a04d12100db370d81485cdf75e47ca",
            "b968826d9c46dd6066d109eabc6255188de91218"
          ],
          "title": "Base Revision",
          "type": "string"
        },
        "dataset_manifest_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dataset Manifest Sha256"
        },
        "dataset_version": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dataset Version"
        },
        "model_artifact_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Model Artifact Sha256",
          "type": "string"
        },
        "model_parameters": {
          "exclusiveMinimum": 0,
          "title": "Model Parameters",
          "type": "integer"
        },
        "repository": {
          "enum": [
            "Qwen/Qwen3-0.6B",
            "Qwen/Qwen3-8B"
          ],
          "title": "Repository",
          "type": "string"
        },
        "role": {
          "enum": [
            "base",
            "candidate"
          ],
          "title": "Role",
          "type": "string"
        },
        "training_checkpoint_id": {
          "anyOf": [
            {
              "pattern": "^checkpoint-tokens-[0-9]{10}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Training Checkpoint Id"
        },
        "training_config_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Training Config Sha256"
        },
        "training_run_id": {
          "anyOf": [
            {
              "maxLength": 180,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Training Run Id"
        },
        "training_tokens": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 100000000,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Training Tokens"
        }
      },
      "required": [
        "role",
        "repository",
        "base_revision",
        "attention_architecture",
        "adaptation",
        "model_artifact_sha256",
        "model_parameters"
      ],
      "title": "M6ModelIdentity",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Hash-verified path projection accepted only by serving and evaluation flows.",
  "properties": {
    "adapter_artifact_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Adapter Artifact Sha256"
    },
    "adapter_dir": {
      "anyOf": [
        {
          "format": "path",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Adapter Dir"
    },
    "adapter_routing_policy": {
      "anyOf": [
        {
          "$ref": "#/$defs/M10AdapterRoutingPolicy"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "evaluation_subject_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Evaluation Subject Sha256",
      "type": "string"
    },
    "model": {
      "$ref": "#/$defs/M6ModelIdentity"
    },
    "model_artifact_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Model Artifact Sha256",
      "type": "string"
    },
    "model_dir": {
      "format": "path",
      "title": "Model Dir",
      "type": "string"
    },
    "model_version": {
      "pattern": "^(qwen3-8b-m9-(base|historical-lora)|qwen3-0-6b-m10-full-sft-(1m|5m)|qwen3-8b-m10-agent-lora-(1m|3m|4m|5m|10m))-[0-9a-f]{8}$",
      "title": "Model Version",
      "type": "string"
    },
    "requested_ref": {
      "pattern": "^(qwen3-8b-m9-(base|historical-lora)|qwen3-0-6b-m10-full-sft-(1m|5m)|qwen3-8b-m10-agent-lora-(1m|3m|4m|5m|10m))-[0-9a-f]{8}$",
      "title": "Requested Ref",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "const": "Evaluation",
      "default": "Evaluation",
      "title": "Status",
      "type": "string"
    },
    "tokenizer_artifact_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Tokenizer Artifact Sha256",
      "type": "string"
    },
    "tokenizer_dir": {
      "format": "path",
      "title": "Tokenizer Dir",
      "type": "string"
    },
    "verified_at": {
      "format": "date-time",
      "title": "Verified At",
      "type": "string"
    }
  },
  "required": [
    "requested_ref",
    "model_version",
    "evaluation_subject_sha256",
    "model",
    "model_dir",
    "model_artifact_sha256",
    "tokenizer_dir",
    "tokenizer_artifact_sha256",
    "verified_at"
  ],
  "title": "ResolvedEvaluationSubject",
  "type": "object"
}
